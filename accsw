def http_get_json(url: str, token: str) -> dict:
    """GET with a bearer token, refusing redirects.

    ACCSW_OFFLINE=1 makes this raise instead of reaching the network. The tests set
    it so that a forgotten stub fails loudly rather than quietly spending the
    account's rate-limit budget.

    urllib copies every header onto a redirected request without comparing hosts, so
    following one would hand a live access token to whatever host answered.
    """
    if os.environ.get("ACCSW_OFFLINE") == "1":
        raise Fail(f"offline: refused to call {url.split('/')[2]}")

    import urllib.error
    import urllib.request

    class RefuseRedirects(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *arguments, **keywords):
            return None

    request = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "Accept": "application/json",
        },
    )
    try:
        opener = urllib.request.build_opener(RefuseRedirects)
        with opener.open(request, timeout=HTTP_TIMEOUT) as response:
            return json.loads(response.read())
    except urllib.error.HTTPError as error:
        if error.code == 429:
            delay = error.headers.get("retry-after")
            delay = int(delay) if delay and delay.isdigit() else 900
            until = int(time.time()) + delay
            raise RateLimited(f"rate limited until {humanize_reset(until)} from now", until)
        if error.code in (401, 403):
            raise Fail("token expired — switch to this account once to refresh it")
        if 300 <= error.code < 400:
            raise Fail(f"refused a {error.code} redirect — the token stays on this host")
        raise Fail(f"HTTP {error.code}")
    except urllib.error.URLError as error:
        raise Fail(f"unreachable ({error.reason})")
    except json.JSONDecodeError:
        raise Fail("response was not JSON")


def parse_epoch(value) -> int | None:
    """Windows report their reset as epoch seconds, epoch millis, or ISO-8601."""
    if isinstance(value, (int, float)):
        return int(value / 1000) if value > 1e12 else int(value)
    if isinstance(value, str):
        from datetime import datetime

        try:
            return int(datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp())
        except ValueError:
            return None
    return None


def claude_access_token(blob: str | None) -> str:
    if blob is None:
        raise Fail("no stored credential")
    token = (json.loads(blob).get("claudeAiOauth") or {}).get("accessToken")
    if not token:
        raise Fail("credential has no access token")
    return token


def codex_access_token(document: str | None) -> str:
    if document is None:
        raise Fail("no stored credential")
    payload = json.loads(document)
    token = (payload.get("tokens") or {}).get("access_token") or payload.get("access_token")
    if not token:
        raise Fail("credential has no access token (API-key mode has no usage window)")
    return token


def read_file(path: Path) -> str | None:
    return path.read_text(encoding="utf-8") if path.is_file() else None


def profile_token(tool: str, profile: str) -> str:
    if tool == "claude":
        return claude_access_token(keychain_read(profile_service(profile)))
    return codex_access_token(read_file(CODEX_VAULT / f"{profile}.json"))



def claude_oauth_identity(token: str) -> dict:
    """Ask the API whose credential this is, rather than making the user type it."""
    payload = http_get_json(CLAUDE_PROFILE_URL, token)
    account = payload.get("account") or {}
    organization = payload.get("organization") or {}
    if not account.get("email"):
        raise Fail("the profile endpoint returned no address for this credential")
    return {
        "emailAddress": account["email"],
        "accountUuid": account.get("uuid"),
        "organizationUuid": organization.get("uuid"),
        "organizationName": organization.get("name"),
        "organizationType": organization.get("organization_type"),
    }


def claude_quota(token: str) -> list[tuple[str, float, int | None]]:
    """Read the `limits` array, not the flat five_hour/seven_day keys.

    Those two are only the unscoped windows. The per-model ones live here — and a
    model-scoped limit is routinely the binding one: an account can read 99% free on
    its 5h window while Fable sits at 100%, which is exactly the account auto-select
    must not pick.
    """
    payload = http_get_json(CLAUDE_USAGE_URL, token)
    windows = []
    for entry in payload.get("limits") or []:
        percent = entry.get("percent")
        if percent is None:
            continue
        label = CLAUDE_WINDOWS.get(entry.get("kind"))
        if label is None:
            model = ((entry.get("scope") or {}).get("model") or {}).get("display_name")
            label = model or entry.get("kind") or "?"
        windows.append((label, float(percent), parse_epoch(entry.get("resets_at"))))
    return windows


def window_label(seconds) -> str:
    """Name a window by its own declared length rather than assuming 5h/7d."""
    if not isinstance(seconds, (int, float)) or seconds <= 0:
        return "?"
    hours = seconds / 3600
    return f"{int(hours)}h" if hours < 24 else f"{int(hours / 24)}d"


def codex_quota(token: str) -> list[tuple[str, float, int | None]]:
    """`wham/usage` is the free read.

    Not `wham/profiles/me`, which returns lifetime stats and no limits at all.
    Each window carries used_percent, its own length, and an absolute reset_at.
    """
    payload = http_get_json(CODEX_USAGE_URL, token)
    windows = []

    def collect(limit: dict, name: str | None) -> None:
        for key in ("primary_window", "secondary_window"):
            window = limit.get(key)
            if not isinstance(window, dict):
                continue
            windows.append(
                (
                    name or window_label(window.get("limit_window_seconds")),
                    float(window.get("used_percent", 0.0)),
                    parse_epoch(window.get("reset_at")),
                )
            )

    collect(payload.get("rate_limit") or {}, None)
    return windows


QUOTA = {"claude": claude_quota, "codex": codex_quota}


def gather_quota(registry: dict, tools: tuple[str, ...] = TOOLS):
    """Query every captured account, one at a time. Values are window lists or Fail.

    Sequential on purpose: a burst of simultaneous authenticated requests for several
    different accounts from one address is exactly the shape anti-abuse systems act on.
    """
    jobs = [
        (name, tool)
        for name, entry in registry["profiles"].items()
        for tool in tools
        if tool in entry
    ]
    cache = registry.setdefault("quota_cache", {})
    now = int(time.time())
    snapshot: dict[tuple[str, str], object] = {}
    ages: dict[tuple[str, str], int] = {}

    for position, (name, tool) in enumerate(jobs):
        slot = cache.setdefault(f"{name}|{tool}", {})
        stored = [tuple(window) for window in slot["windows"]] if "windows" in slot else None
        if stored is not None and slot["at"] > now - QUOTA_TTL:
            snapshot[(name, tool)] = stored
            continue
        if slot.get("blocked_until", 0) > now and stored is not None:
            # Rate-limited and we still hold numbers: show those rather than nothing.
            snapshot[(name, tool)] = stored
            ages[(name, tool)] = now - slot["at"]
            continue
        if slot.get("blocked_until", 0) > now:
            snapshot[(name, tool)] = Fail(slot["error"])
            continue
        if position:
            time.sleep(0.15)
        try:
            windows = QUOTA[tool](profile_token(tool, name))
            slot.update({"at": now, "windows": windows})
            slot.pop("blocked_until", None)
            snapshot[(name, tool)] = windows
        except RateLimited as error:
            slot.update({"error": str(error), "blocked_until": error.until})
            if stored is not None:
                snapshot[(name, tool)] = stored
                ages[(name, tool)] = now - slot["at"]
            else:
                snapshot[(name, tool)] = error
        except Fail as error:
            if stored is not None:
                snapshot[(name, tool)] = stored
                ages[(name, tool)] = now - slot["at"]
            else:
                snapshot[(name, tool)] = error
        except Exception as error:  # a quota probe must never take the switcher down
            snapshot[(name, tool)] = Fail(f"unexpected response ({type(error).__name__})")
    return snapshot, ages


def effective_percent(percent: float, resets_at: int | None) -> float:
    """A window past its reset has rolled over, whatever the stored number says."""
    if resets_at is not None and resets_at <= int(time.time()):
        return 0.0
    return percent


def bar(percent: float, width: int = 10) -> str:
    filled = round(min(max(percent, 0.0), 100.0) / 100 * width)
    return "█" * filled + "░" * (width - filled)


def humanize_reset(timestamp: int | None) -> str:
    if timestamp is None:
        return ""
    from datetime import datetime

    delta = timestamp - int(time.time())
    if delta <= 0:
        return "now"
    hours, minutes = divmod(delta // 60, 60)
    days, hours = divmod(hours, 24)
    if days >= 1:
        return f"{days}d {hours}h" if hours else f"{days}d"
    if hours >= 1:
        return f"{hours}h {minutes}m" if minutes else f"{hours}h"
    return f"{minutes}m"



# One colour per tool so a glance separates them, plus green for what is loaded.
TOOL_COLOUR = {"claude": "38;5;209", "codex": "38;5;79"}
LOADED = "38;5;76"
DIM = "2"
BOLD = "1"


def paint(text: str, code: str, enabled: bool) -> str:
    return f"{ESC}[{code}m{text}{ESC}[0m" if enabled else text


def remaining_colour(left: float) -> str:
    if left >= 50:
        return "32"
    return "33" if left >= 20 else "31"


def quota_lines(result, colour: bool) -> list[str]:
    """One aligned line per window, coloured by how much is left.

    An exhausted window is reported alone: showing "5h 100% left" beside a spent
    weekly window reads as capacity that does not exist.
    """
    if isinstance(result, Fail):
        return [paint(f"— {result}", "31", colour)]
    if not result:
        return ["— no window reported"]
    # A spent week makes the 5h window meaningless: it can read 100% and buy nothing.
    # Drop that one line rather than the whole gauge — the rest still says something.
    spent = {label for label, _ in (blocking(result) or [])}
    result = [
        window for window in result if not (window[0] == "5h" and spent - {"5h"})
    ]
    width = max(len(label) for label, _, _ in result)
    lines = []
    for label, percent, resets_at in result:
        left = 100.0 - effective_percent(percent, resets_at)
        countdown = humanize_reset(resets_at)
        when = f"resets in {countdown}" if countdown else "just reset"
        lines.append(
            f"{paint(f'{label:<{width}}', DIM, colour)} "
            f"{paint(bar(left), remaining_colour(left), colour)} "
            f"{left:>3.0f}% left   {paint(when, DIM, colour)}"
        )
    return lines



# Which windows decide, and in what order. Claude is asked for Fable first because
# that is the limit that actually stops work here; Codex reports one window and it
# is the answer. Windows outside this order are still shown, they just do not vote.
SELECTION_ORDER = {"claude": ("Fable", "5h", "7d")}


def remaining_by_label(result) -> dict[str, float] | None:
    if isinstance(result, Fail) or not result:
        return None
    return {label: 100.0 - effective_percent(percent, at) for label, percent, at in result}


# Spending an unscoped window stops the account outright. Spending a model-scoped one
# only stops that model, so it steers the choice instead of disqualifying the account.
BLOCKING_LABELS = {"5h", "7d"}


def blocking(result) -> list[tuple[str, int | None]] | None:
    if isinstance(result, Fail) or not result:
        return None
    return [
        (label, at)
        for label, percent, at in result
        if label in BLOCKING_LABELS and effective_percent(percent, at) >= 100.0
    ]


def selection_key(result, tool: str) -> tuple[float, ...] | None:
    """Remaining capacity in priority order. Compared highest-first, so a tie on
    Fable falls through to the 5h window, then to the week."""
    left = remaining_by_label(result)
    if left is None:
        return None
    order = SELECTION_ORDER.get(tool)
    width = len(order) if order else 1
    if blocking(result):
        # Exhausted on an unscoped window: unusable whatever the rest says. Same
        # width as every other key for this tool — tuples of different lengths
        # compare by prefix, so a shorter one would sort ahead of a healthy account.
        return (-1.0,) * width
    if not order:
        return (min(left.values()),)
    return tuple(left.get(label, 100.0) for label in order)


def deciding_window(result, tool: str) -> tuple[str, float] | None:
    """The first window this tool cares about that the account actually reports."""
    left = remaining_by_label(result)
    if left is None:
        return None
    for label in SELECTION_ORDER.get(tool) or ():
        if label in left:
            return label, left[label]
    return min(left.items(), key=lambda item: item[1])



# ------------------------------------------------------------------- picker

ESC = "\x1b"






def best_profile(registry: dict, quota: dict, tool: str) -> tuple[str | None, str]:
    """The account with the most left for ONE tool. Ties keep whatever is loaded.

    One tool at a time on purpose: the two slots are independent logins, and their
    keys are not the same measurement — Claude ranks on three windows, Codex on one.
    Comparing them merged is how an exhausted account outranks a usable one.
    """
    active = registry.get("active", {})
    labels: dict[str, tuple[str, float] | None] = {}
    ranked = []
    for name, entry in registry["profiles"].items():
        if tool not in entry or entry[tool].get("needs_signin"):
            continue
        key = selection_key(quota.get((name, tool)), tool)
        labels[name] = deciding_window(quota.get((name, tool)), tool)
        # Reachable first: an account whose quota cannot be read is one whose
        # credential we could not prove works, and switching onto it is how a dead
        # token reaches the slot.
        ranked.append((0 if key is None else 1, key or (0.0,), active.get(tool) == name, name))
    if not ranked:
        return None, "no account is captured for that tool"
    ranked.sort(key=lambda row: (-row[0], tuple(-value for value in row[1]), not row[2], row[3]))
    measured, _, _, name = ranked[0]
    if measured and labels[name]:
        label, value = labels[name]
        return name, f"{label} at {value:.0f}% left"
    return name, "no account answered; this one's token refreshes on first use"



# ----------------------------------------------------------------- commands




# Desktop apps that read the same credential slot — both verified to query it the
# same way the CLI does. They cache the token at startup, so a switch reaches them
# only on relaunch. IDE extensions are absent on purpose: they spawn a fresh CLI
# process per session, so a NEW chat already picks up the new account.
GUI_APPS = {"claude": "Claude", "codex": "ChatGPT"}


# Claude.app reads CLAUDE_USER_DATA_DIR and CLAUDE_CONFIG_DIR at startup, both
# ungated, and holds no single-instance lock. So each account gets its own profile
# and stays signed in there — nothing to swap, nothing to identify.
CLAUDE_APP_DATA = STORE / "claude-app"
CLAUDE_BINARY = Path("/Applications/Claude.app/Contents/MacOS/Claude")


def quit_app(name: str) -> None:
    if not app_running(name):
        return
    run(["osascript", "-e", f'tell application "{name}" to quit'])
    for _ in range(24):
        if not app_running(name):
            return
        time.sleep(0.25)
    raise Fail(f"{name} did not quit; it was left on its current account")


CLAUDE_APP_SUPPORT = HOME / "Library" / "Application Support" / "Claude"


def point_claude_app_at(profile: str) -> bool:
    """Make the app's own support directory a link to this profile's.

    Environment variables only reach the app when accsw launches it; opening it
    from the Dock would land on the default profile instead. Linking the path the
    app always reads puts it on the right account however it is started.

    Returns True when the link had to move, so the caller knows a restart is due.
    """
    target = CLAUDE_APP_DATA / profile
    target.mkdir(parents=True, exist_ok=True)
    target.chmod(0o700)

    if CLAUDE_APP_SUPPORT.is_symlink():
        if CLAUDE_APP_SUPPORT.readlink() == target:
            return False
        quit_app("Claude")
        CLAUDE_APP_SUPPORT.unlink()
    elif CLAUDE_APP_SUPPORT.exists():
        # A real directory from before accsw: kept whole, once, under its own name.
        quit_app("Claude")
        kept = CLAUDE_APP_DATA / "_before-accsw"
        if kept.exists():
            raise Fail(f"{kept} already exists — move it aside by hand and rerun")
        CLAUDE_APP_DATA.mkdir(parents=True, exist_ok=True)
        CLAUDE_APP_SUPPORT.rename(kept)
        note(f"kept the previous Claude profile as {kept}")
    CLAUDE_APP_SUPPORT.symlink_to(target)
    return True


def launch_claude_app(profile: str) -> None:
    """Put the app on this profile, then start it.

    Its built-in Claude Code reads the canonical keychain item, which the switch
    already installed, so both halves of the window agree without extra plumbing.
    """
    if not CLAUDE_BINARY.exists():
        return
    point_claude_app_at(profile)
    subprocess.Popen(
        [str(CLAUDE_BINARY)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def app_running(name: str) -> bool:
    """Raises rather than guessing.

    Automation is gated behind a TCC grant, so a refusal comes back non-zero with
    empty output. Reading that as "not running" would let the caller relink — or
    rename — the support directory of an app that is very much running.
    """
    result = run(
        [
            "osascript",
            "-e",
            f'tell application "System Events" to (name of processes) contains "{name}"',
        ]
    )
    answer = result.stdout.strip()
    if result.returncode != 0 or answer not in ("true", "false"):
        raise Fail(
            f"cannot tell whether {name} is running: {diagnose(result)}. "
            "Grant Automation access to your terminal in System Settings → Privacy."
        )
    return answer == "true"


def restart_app(name: str) -> None:
    """Ask the app to quit — never kill it — then bring it back."""
    quit_app(name)
    run(["open", "-a", name])


def note(message: str) -> None:
    """Chatter goes to stderr so it never pollutes piped output."""
    print(f"accsw: {message}", file=sys.stderr)


def settle_readers(tools: tuple[str, ...], profile: str | None, registry: dict) -> None:
    """Put the desktop apps on the account that was just installed.

    ChatGPT.app reads $CODEX_HOME/auth.json — the very slot that was swapped — so a
    relaunch is enough. Claude.app is opened on this profile's own directories.
    """
    for tool in tools:
        name = GUI_APPS[tool]
        live = app_running(name)
        if tool == "claude" and profile:
            # Already on this profile and running: leave it be.
            if live and registry.get("app_profile") == profile:
                continue
            launch_claude_app(profile)
            registry["app_profile"] = profile
            note(f"{'reopened' if live else 'opened'} {name} on {profile}")
        elif live:
            restart_app(name)
            note(f"reopened {name}")
        else:
            # It reads the slot we just wrote, so simply starting it is enough.
            run(["open", "-a", name])
            note(f"opened {name}")
    for tool in tools:
        if running(tool):
            note(f"open {tool} sessions keep the old account; new ones start on the new one")



def apply_switch(profile: str, tools: tuple[str, ...], registry: dict) -> list[str]:
    """Preflight every leg, then swap them one at a time, recording each as it lands."""
    for tool in tools:
        PREFLIGHT[tool](profile, registry)

    outcome = []
    for tool in tools:
        if actually_loaded(tool, registry) == profile:
            outcome.append("already loaded")
            continue
        email = RESTORE[tool](profile, registry)
        save_registry(registry)
        outcome.append(email)
    return outcome








def cmd_list(args) -> int:
    registry = load_state()
    profiles = registry["profiles"]
    if not profiles:
        print("no accounts yet — `accsw add claude` or `accsw add codex`")
        return 0
    active = registry.get("active", {})
    colour = sys.stdout.isatty()
    width = max(len(name) for name in profiles)
    for name in sorted(profiles):
        held = []
        for tool in TOOLS:
            if tool not in profiles[name]:
                continue
            mark = paint("●", LOADED, colour) if active.get(tool) == name else paint("○", DIM, colour)
            held.append(
                f"{mark} {paint(tool, TOOL_COLOUR[tool], colour)} "
                f"{paint(profiles[name][tool].get('email') or 'unknown', DIM, colour)}"
            )
        print(f"{name:<{width}}  " + "   ".join(held))
    return 0


def cmd_status(args) -> int:
    registry = load_state()
    profiles = registry["profiles"]
    if not profiles:
        print("no accounts captured yet — log in to one and run accsw")
        return 0
    active = registry.get("active", {})
    colour = sys.stdout.isatty()
    quota, ages = gather_quota(registry)
    # Written back, or the five-minute cache and the Retry-After backoff would last
    # exactly as long as this process and re-ask the moment you look again.
    save_registry(registry)
    for position, name in enumerate(sorted(profiles)):
        if position:
            print()
        loaded = [tool for tool in TOOLS if active.get(tool) == name]
        title = paint(name, BOLD, colour) if loaded else name
        tag = paint("  in use", LOADED, colour) if loaded else ""
        print(f"{title}{tag}")
        for tool in TOOLS:
            if tool not in profiles[name]:
                continue
            here = active.get(tool) == name
            mark = paint("●", LOADED, colour) if here else paint("○", DIM, colour)
            email = profiles[name][tool].get("email") or "unknown"
            flag = (
                paint("  sign-in needed", "31", colour)
                if profiles[name][tool].get("needs_signin")
                else ""
            )
            print(
                f"  {mark} {paint(f'{tool:<7}', TOOL_COLOUR[tool], colour)} "
                f"{paint(email, DIM, colour)}{flag}"
            )
            age = ages.get((name, tool))
            for line in quota_lines(quota.get((name, tool)), colour):
                print(f"      {line}")
            if age is not None:
                print(f"      {paint(f'(rate limited — figures from {humanize_reset(int(time.time()) + age)} ago)', '2', colour)}")

    return 0


def cmd_auto(args) -> int:
    """Choose per tool. The two credential slots are independent, and an account that
    only exists for one of them must never decide the other."""
    registry = load_state()
    if not registry["profiles"]:
        raise Fail("no accounts captured yet — log in to one and run accsw")
    tools = TOOLS
    quota, _ = gather_quota(registry, tools)
    for tool in tools:
        name, why = best_profile(registry, quota, tool)
        if name is None:
            note(f"{tool}: {why}")
            continue
        if actually_loaded(tool, registry) == name:
            # Nothing changed, so nothing is bounced. Bouncing a window to land on the
            # account it is already on is pure interruption — and when every account is
            # spent, that is every single run. The link is still checked, because it
            # costs nothing and decides where a Dock launch lands.
            print(f"{tool}: staying on {name} — {why}")
            if tool == "claude" and CLAUDE_BINARY.exists():
                # Sampled first: relinking quits the app, so asking afterwards always
                # answers "not running" and the window never comes back.
                live = app_running("Claude")
                if point_claude_app_at(name):
                    note(f"pointed Claude at {name}")
                    if live:
                        launch_claude_app(name)
            continue
        for line in apply_switch(name, (tool,), registry):
            print(f"{tool}: {line}")
        print(f"  → {name}, {why}")
        settle_readers((tool,), args.restart, name, registry)
    return 0


def claude_namespaced_service(directory: Path) -> str:
    """The keychain item a login writes when CLAUDE_SECURESTORAGE_CONFIG_DIR is set.

    Taken from the binary: the base name gains a suffix of the first eight hex
    characters of sha256 over the NFC-normalised directory path.
    """
    import hashlib
    import unicodedata

    digest = hashlib.sha256(
        unicodedata.normalize("NFC", str(directory)).encode("utf-8")
    ).hexdigest()[:8]
    return f"{CLAUDE_KEYCHAIN_SERVICE}-{digest}"


def cmd_add(args) -> int:
    """Sign in to another account beside the current one, and keep it.

    The login runs against a throwaway config directory, so the credential that is
    loaded right now is never touched — no logging out to log back in.
    """
    tool = args.tool_name
    registry = load_state()
    workspace = Path(tempfile.mkdtemp(prefix="accsw-add-"))
    try:
        return complete_add(args, tool, registry, workspace)
    finally:
        # It holds a live credential the moment the sign-in succeeds, so it goes
        # whatever happens after — including the failures that raise past here.
        shutil.rmtree(workspace, ignore_errors=True)


def complete_add(args, tool: str, registry: dict, workspace: Path) -> int:
    print(f"signing in to a new {tool} account — the current one stays put\n")

    if tool == "codex":
        subprocess.run(["codex", "login"], env={**os.environ, "CODEX_HOME": str(workspace)})
        source = workspace / "auth.json"
        if not source.is_file():
            raise Fail("no credential was written — the sign-in did not complete")
        blob = source.read_text(encoding="utf-8")
        email = jwt_email((json.loads(blob).get("tokens") or {}).get("id_token"))
    else:
        service = claude_namespaced_service(workspace)
        subprocess.run(
            ["claude", "auth", "login"],
            env={**os.environ, "CLAUDE_SECURESTORAGE_CONFIG_DIR": str(workspace)},
        )
        blob = keychain_read(service)
        if blob is None:
            raise Fail("no credential was written — the sign-in did not complete")
        account = claude_oauth_identity(claude_access_token(blob))
        email = account["emailAddress"]

    if email is None:
        email = args.email
    if email is None:
        raise Fail(
            "signed in, but the account's address could not be read — "
            f"rerun with `accsw add {tool} --email you@example.com`"
        )

    name = name_for(email, tool, registry)
    registry["profiles"].setdefault(name, {}).pop(tool, None)
    if tool == "codex":
        CODEX_VAULT.mkdir(parents=True, exist_ok=True)
        CODEX_VAULT.chmod(0o700)
        atomic_write(CODEX_VAULT / f"{name}.json", blob)
        registry["profiles"].setdefault(name, {})["codex"] = {"email": email}
    else:
        keychain_write(profile_service(name), blob, f"accsw claude — {name}")
        registry["profiles"].setdefault(name, {})["claude"] = {
            "email": email,
            "oauthAccount": account,
        }
        # Only now that it is filed: dropping it any earlier would throw away a
        # sign-in the user just completed.
        keychain_delete(claude_namespaced_service(workspace))
    save_registry(registry)
    print(f"\nadded {email} as {name!r} — `accsw` will use it when it has the most left")
    return 0




def main() -> int:
    parser = argparse.ArgumentParser(prog="accsw", description=__doc__.splitlines()[0])
    subparsers = parser.add_subparsers(dest="command")
    parser.set_defaults(handler=cmd_auto)





    adding = subparsers.add_parser("add", help="sign in to another account and keep it")
    adding.add_argument("tool_name", choices=TOOLS)
    adding.add_argument("--email", help="the address, when it cannot be read back")
    adding.set_defaults(handler=cmd_add)

    listing = subparsers.add_parser("list", help="list captured profiles")
    listing.set_defaults(handler=cmd_list)

    status = subparsers.add_parser("status", help="show who is logged in, with quota")
    status.set_defaults(handler=cmd_status)




    args = parser.parse_args()
    try:
        with hold_lock():
            return args.handler(args)
    except Fail as error:
        print(f"accsw: {error}", file=sys.stderr)
        return 1
    except (OSError, json.JSONDecodeError) as error:
        print(f"accsw: {type(error).__name__}: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\naccsw: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
