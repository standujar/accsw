CLAUDE_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
CLAUDE_PROFILE_URL = "https://api.anthropic.com/api/oauth/profile"
CODEX_USAGE_URL = "https://chatgpt.com/backend-api/wham/usage"
HTTP_TIMEOUT = 6
QUOTA_TTL = 300

# The unscoped windows get short names; anything model-scoped is named after its model.
CLAUDE_WINDOWS = {"session": "5h", "weekly_all": "7d"}


def http_get_json(url: str, token: str) -> dict:
    """GET with a bearer token, refusing redirects.

    ACCSW_OFFLINE=1 makes this raise instead of reaching the network. The tests set
    it so that a forgotten stub fails loudly rather than quietly spending the
    account's rate-limit budget.

    urllib copies every header onto a redirected request without comparing hosts, so
    following one would hand a live access token to whatever host answered.
    """
    if os.environ.get("ACCSW_OFFLINE") == "1":
        raise Fail(f"offline: refused to call {url.split('/')[2]}")

    import urllib.error
    import urllib.request

    class RefuseRedirects(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *arguments, **keywords):
            return None

    request = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "Accept": "application/json",
        },
    )
    try:
        opener = urllib.request.build_opener(RefuseRedirects)
        with opener.open(request, timeout=HTTP_TIMEOUT) as response:
            return json.loads(response.read())
    except urllib.error.HTTPError as error:
        if error.code == 429:
            delay = error.headers.get("retry-after")
            delay = int(delay) if delay and delay.isdigit() else 900
            until = int(time.time()) + delay
            raise RateLimited(f"rate limited until {humanize_reset(until)} from now", until)
        if error.code in (401, 403):
            raise Fail("token expired — switch to this account once to refresh it")
        if 300 <= error.code < 400:
            raise Fail(f"refused a {error.code} redirect — the token stays on this host")
        raise Fail(f"HTTP {error.code}")
    except urllib.error.URLError as error:
        raise Fail(f"unreachable ({error.reason})")
    except json.JSONDecodeError:
        raise Fail("response was not JSON")


def parse_epoch(value) -> int | None:
    """Windows report their reset as epoch seconds, epoch millis, or ISO-8601."""
    if isinstance(value, (int, float)):
        return int(value / 1000) if value > 1e12 else int(value)
    if isinstance(value, str):
        from datetime import datetime

        try:
            return int(datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp())
        except ValueError:
            return None
    return None


def claude_access_token(blob: str | None) -> str:
    if blob is None:
        raise Fail("no stored credential")
    token = (json.loads(blob).get("claudeAiOauth") or {}).get("accessToken")
    if not token:
        raise Fail("credential has no access token")
    return token


def codex_access_token(document: str | None) -> str:
    if document is None:
        raise Fail("no stored credential")
    payload = json.loads(document)
    token = (payload.get("tokens") or {}).get("access_token") or payload.get("access_token")
    if not token:
        raise Fail("credential has no access token (API-key mode has no usage window)")
    return token


def read_file(path: Path) -> str | None:
    return path.read_text(encoding="utf-8") if path.is_file() else None


def profile_token(tool: str, profile: str) -> str:
    if tool == "claude":
        return claude_access_token(keychain_read(profile_service(profile)))
    return codex_access_token(read_file(CODEX_VAULT / f"{profile}.json"))



def claude_oauth_identity(token: str) -> dict:
    """Ask the API whose credential this is, rather than making the user type it."""
    payload = http_get_json(CLAUDE_PROFILE_URL, token)
    account = payload.get("account") or {}
    organization = payload.get("organization") or {}
    if not account.get("email"):
        raise Fail("the profile endpoint returned no address for this credential")
    return {
        "emailAddress": account["email"],
        "accountUuid": account.get("uuid"),
        "organizationUuid": organization.get("uuid"),
        "organizationName": organization.get("name"),
        "organizationType": organization.get("organization_type"),
    }


def claude_quota(token: str) -> list[tuple[str, float, int | None]]:
    """Read the `limits` array, not the flat five_hour/seven_day keys.

    Those two are only the unscoped windows. The per-model ones live here — and a
    model-scoped limit is routinely the binding one: an account can read 99% free on
    its 5h window while Fable sits at 100%, which is exactly the account auto-select
    must not pick.
    """
    payload = http_get_json(CLAUDE_USAGE_URL, token)
    windows = []
    for entry in payload.get("limits") or []:
        percent = entry.get("percent")
        if percent is None:
            continue
        label = CLAUDE_WINDOWS.get(entry.get("kind"))
        if label is None:
            model = ((entry.get("scope") or {}).get("model") or {}).get("display_name")
            label = model or entry.get("kind") or "?"
        windows.append((label, float(percent), parse_epoch(entry.get("resets_at"))))
    return windows


def window_label(seconds) -> str:
    """Name a window by its own declared length rather than assuming 5h/7d."""
    if not isinstance(seconds, (int, float)) or seconds <= 0:
        return "?"
    hours = seconds / 3600
    return f"{int(hours)}h" if hours < 24 else f"{int(hours / 24)}d"


def codex_quota(token: str) -> list[tuple[str, float, int | None]]:
    """`wham/usage` is the free read.

    Not `wham/profiles/me`, which returns lifetime stats and no limits at all.
    Each window carries used_percent, its own length, and an absolute reset_at.
    """
    payload = http_get_json(CODEX_USAGE_URL, token)
    windows = []

    def collect(limit: dict, name: str | None) -> None:
        for key in ("primary_window", "secondary_window"):
            window = limit.get(key)
            if not isinstance(window, dict):
                continue
            windows.append(
                (
                    name or window_label(window.get("limit_window_seconds")),
                    float(window.get("used_percent", 0.0)),
                    parse_epoch(window.get("reset_at")),
                )
            )

    collect(payload.get("rate_limit") or {}, None)
    return windows


QUOTA = {"claude": claude_quota, "codex": codex_quota}


def gather_quota(registry: dict, tools: tuple[str, ...] = TOOLS):
    """Query every captured account, one at a time. Values are window lists or Fail.

    Sequential on purpose: a burst of simultaneous authenticated requests for several
    different accounts from one address is exactly the shape anti-abuse systems act on.
    """
    jobs = [
        (name, tool)
        for name, entry in registry["profiles"].items()
        for tool in tools
        if tool in entry
    ]
    cache = registry.setdefault("quota_cache", {})
    now = int(time.time())
    snapshot: dict[tuple[str, str], object] = {}
    ages: dict[tuple[str, str], int] = {}

    for position, (name, tool) in enumerate(jobs):
        slot = cache.setdefault(f"{name}|{tool}", {})
        stored = [tuple(window) for window in slot["windows"]] if "windows" in slot else None
        if stored is not None and slot["at"] > now - QUOTA_TTL:
            snapshot[(name, tool)] = stored
            continue
        if slot.get("blocked_until", 0) > now and stored is not None:
            # Rate-limited and we still hold numbers: show those rather than nothing.
            snapshot[(name, tool)] = stored
            ages[(name, tool)] = now - slot["at"]
            continue
        if slot.get("blocked_until", 0) > now:
            snapshot[(name, tool)] = Fail(slot["error"])
            continue
        if position:
            time.sleep(0.15)
        try:
            windows = QUOTA[tool](profile_token(tool, name))
            slot.update({"at": now, "windows": windows})
            slot.pop("blocked_until", None)
            snapshot[(name, tool)] = windows
        except RateLimited as error:
            slot.update({"error": str(error), "blocked_until": error.until})
            if stored is not None:
                snapshot[(name, tool)] = stored
                ages[(name, tool)] = now - slot["at"]
            else:
                snapshot[(name, tool)] = error
        except Fail as error:
            if stored is not None:
                snapshot[(name, tool)] = stored
                ages[(name, tool)] = now - slot["at"]
            else:
                snapshot[(name, tool)] = error
        except Exception as error:  # a quota probe must never take the switcher down
            snapshot[(name, tool)] = Fail(f"unexpected response ({type(error).__name__})")
    return snapshot, ages


def effective_percent(percent: float, resets_at: int | None) -> float:
    """A window past its reset has rolled over, whatever the stored number says."""
    if resets_at is not None and resets_at <= int(time.time()):
        return 0.0
    return percent


def bar(percent: float, width: int = 10) -> str:
    filled = round(min(max(percent, 0.0), 100.0) / 100 * width)
    return "█" * filled + "░" * (width - filled)


def humanize_reset(timestamp: int | None) -> str:
    if timestamp is None:
        return ""
    from datetime import datetime

    delta = timestamp - int(time.time())
    if delta <= 0:
        return "now"
    hours, minutes = divmod(delta // 60, 60)
    days, hours = divmod(hours, 24)
    if days >= 1:
        return f"{days}d {hours}h" if hours else f"{days}d"
    if hours >= 1:
        return f"{hours}h {minutes}m" if minutes else f"{hours}h"
    return f"{minutes}m"



# One colour per tool so a glance separates them, plus green for what is loaded.
TOOL_COLOUR = {"claude": "38;5;209", "codex": "38;5;79"}
LOADED = "38;5;76"
DIM = "2"
BOLD = "1"


def paint(text: str, code: str, enabled: bool) -> str:
    return f"{ESC}[{code}m{text}{ESC}[0m" if enabled else text


def remaining_colour(left: float) -> str:
    if left >= 50:
        return "32"
    return "33" if left >= 20 else "31"


def quota_lines(result, colour: bool, width: int | None = None) -> list[str]:
    """One aligned line per window, coloured by how much is left.

    An exhausted window is reported alone: showing "5h 100% left" beside a spent
    weekly window reads as capacity that does not exist.
    """
    if isinstance(result, Fail):
        return [paint(f"— {result}", "31", colour)]
    if not result:
        return ["— no window reported"]
    # A spent week makes the 5h window meaningless: it can read 100% and buy nothing.
    # Drop that one line rather than the whole gauge — the rest still says something.
    spent = {label for label, _ in (blocking(result) or [])}
    result = [
        window for window in result if not (window[0] == "5h" and spent - {"5h"})
    ]
    width = width or max(len(label) for label, _, _ in result)
    lines = []
    for label, percent, resets_at in result:
        left = 100.0 - effective_percent(percent, resets_at)
        countdown = humanize_reset(resets_at)
        when = f"resets in {countdown}" if countdown else "just reset"
        lines.append(
            f"{paint(f'{label:<{width}}', DIM, colour)} "
            f"{paint(bar(left), remaining_colour(left), colour)} "
            f"{left:>3.0f}% left   {paint(when, DIM, colour)}"
        )
    return lines



# Which windows decide, and in what order. Claude is asked for Fable first because
# that is the limit that actually stops work here; Codex reports one window and it
# is the answer. Windows outside this order are still shown, they just do not vote.
SELECTION_ORDER = {"claude": ("Fable", "5h", "7d")}


def remaining_by_label(result) -> dict[str, float] | None:
    if isinstance(result, Fail) or not result:
        return None
    return {label: 100.0 - effective_percent(percent, at) for label, percent, at in result}


# Spending an unscoped window stops the account outright. Spending a model-scoped one
# only stops that model, so it steers the choice instead of disqualifying the account.
BLOCKING_LABELS = {"5h", "7d"}


def blocking(result) -> list[tuple[str, int | None]] | None:
    if isinstance(result, Fail) or not result:
        return None
    return [
        (label, at)
        for label, percent, at in result
        if label in BLOCKING_LABELS and effective_percent(percent, at) >= 100.0
    ]


def selection_key(result, tool: str) -> tuple[float, ...] | None:
    """Remaining capacity in priority order. Compared highest-first, so a tie on
    Fable falls through to the 5h window, then to the week."""
    left = remaining_by_label(result)
    if left is None:
        return None
    order = SELECTION_ORDER.get(tool)
    width = len(order) if order else 1
    if blocking(result):
        # Exhausted on an unscoped window: unusable whatever the rest says. Same
        # width as every other key for this tool — tuples of different lengths
        # compare by prefix, so a shorter one would sort ahead of a healthy account.
        return (-1.0,) * width
    if not order:
        return (min(left.values()),)
    return tuple(left.get(label, 100.0) for label in order)


def availability(name: str, entry: dict, quota: dict) -> float | None:
    """Mean of what each tool has left, judged on the window that constrains it.

    A display figure, not a ranking one: selection compares within a single tool,
    because Claude's three windows and Codex's one are not the same measurement.
    Averaging them is only defensible for deciding what to print first.
    """
    left = [
        window[1]
        for tool in TOOLS
        if tool in entry
        for window in (deciding_window(quota.get((name, tool)), tool),)
        if window is not None
    ]
    return sum(left) / len(left) if left else None


def deciding_window(result, tool: str) -> tuple[str, float] | None:
    """What actually limits this account for this tool.

    A spent unscoped window wins over the priority order: naming Fable at 95% for an
    account whose week is gone is true about Fable and false about the account, and
    it is what puts a dead account at the top of the list.
    """
    left = remaining_by_label(result)
    if left is None:
        return None
    spent = blocking(result)
    if spent:
        return min(((label, left[label]) for label, _ in spent), key=lambda item: item[1])
    for label in SELECTION_ORDER.get(tool) or ():
        if label in left:
            return label, left[label]
    return min(left.items(), key=lambda item: item[1])



# ------------------------------------------------------------------- picker

ESC = "\x1b"






def best_profile(registry: dict, quota: dict, tool: str) -> tuple[str | None, str]:
    """The account with the most left for ONE tool. Ties keep whatever is loaded.

    One tool at a time on purpose: the two slots are independent logins, and their
    keys are not the same measurement — Claude ranks on three windows, Codex on one.
    Comparing them merged is how an exhausted account outranks a usable one.
    """
    active = registry.get("active", {})
    labels: dict[str, tuple[str, float] | None] = {}
    ranked = []
    for name, entry in registry["profiles"].items():
        if tool not in entry or entry[tool].get("needs_signin"):
            continue
        key = selection_key(quota.get((name, tool)), tool)
        labels[name] = deciding_window(quota.get((name, tool)), tool)
        # Reachable first: an account whose quota cannot be read is one whose
        # credential we could not prove works, and switching onto it is how a dead
        # token reaches the slot.
        ranked.append((0 if key is None else 1, key or (0.0,), active.get(tool) == name, name))
    if not ranked:
        return None, "no account is captured for that tool"
    ranked.sort(key=lambda row: (-row[0], tuple(-value for value in row[1]), not row[2], row[3]))
    measured, _, _, name = ranked[0]
    if measured and labels[name]:
        label, value = labels[name]
        return name, f"{label} at {value:.0f}% left"
    return name, "no account answered; this one's token refreshes on first use"



