#!/usr/bin/env python3
"""accsw — switch Claude Code and Codex between logged-in accounts, no re-login.

Each account is captured once, then switching is a state swap:

  claude  credential lives in the macOS keychain. The service name is
          "Claude Code-credentials", optionally suffixed with the first 8 hex of
          sha256(CLAUDE_CONFIG_DIR) — so a config dir DOES namespace it, but with
          both CLAUDE_CONFIG_DIR and CLAUDE_SECURESTORAGE_CONFIG_DIR unset there
          is exactly one global item. We park each account's blob in its own
          keychain item and copy the wanted one back into the canonical one.
          The plaintext .credentials.json backend exists in the binary but is
          unreachable on macOS: a successful keychain write deletes that file.
  codex   credential is $CODEX_HOME/auth.json, a plain file. We keep one copy
          per account and write the wanted one back.

Sessions, history and project state are deliberately NOT swapped: they are
shared workspace, not identity, and they weigh ~11 GB.
"""

from __future__ import annotations

import argparse
import json
import os
import pwd
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HOME = Path.home()
STORE = Path(os.environ.get("ACCSW_HOME", HOME / ".config" / "accsw"))
REGISTRY = STORE / "registry.json"
CODEX_VAULT = STORE / "codex"

CLAUDE_KEYCHAIN_SERVICE = "Claude Code-credentials"
CLAUDE_KEYCHAIN_ACCOUNT = pwd.getpwuid(os.getuid()).pw_name
CLAUDE_STATE = HOME / ".claude.json"

CODEX_HOME = Path(os.environ.get("CODEX_HOME", HOME / ".codex"))
CODEX_AUTH = CODEX_HOME / "auth.json"

TOOLS = ("claude", "codex")
PROCESS_NAMES = {"claude": ("claude", "claude.exe"), "codex": ("codex",)}


class Fail(Exception):
    pass


# ---------------------------------------------------------------- primitives


ITEM_NOT_FOUND = 44


def run(command: list[str], *, stdin: str | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(
        command,
        input=stdin,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )


def atomic_write(path: Path, data: str, mode: int = 0o600) -> None:
    """Write through a sibling temp file: never truncate the target, never widen it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, staged = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        os.fchmod(handle, mode)
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(staged, path)
    except BaseException:
        Path(staged).unlink(missing_ok=True)
        raise


def looks_hex(text: str) -> bool:
    return (
        not text.startswith("{")
        and len(text) % 2 == 0
        and bool(text)
        and all(char in "0123456789abcdef" for char in text)
    )


def diagnose(result: subprocess.CompletedProcess, secret: str | None = None) -> str:
    """`security` echoes its arguments on failure, so its stderr can contain the secret.

    Never interpolate it raw. Anything carrying the payload — or its hex — is dropped.
    """
    text = " ".join(result.stderr.split())
    if secret and (secret in text or secret.encode("utf-8").hex() in text):
        return "(diagnostic withheld: it contained the credential)"
    return text[:200] or f"exit {result.returncode}"


def keychain_read(service: str) -> str | None:
    """None means the item is genuinely absent; anything else that went wrong raises."""
    result = run(
        ["security", "find-generic-password", "-s", service, "-a", CLAUDE_KEYCHAIN_ACCOUNT, "-w"]
    )
    if result.returncode == ITEM_NOT_FOUND:
        return None
    if result.returncode != 0:
        raise Fail(f"keychain read failed for {service}: {diagnose(result)}")
    secret = result.stdout.strip()
    if not secret:
        return None
    # `security -w` prints hex whenever the stored bytes are not printable ASCII.
    if looks_hex(secret):
        try:
            return bytes.fromhex(secret).decode("utf-8")
        except (ValueError, UnicodeDecodeError):
            raise Fail(f"keychain item {service} is not decodable UTF-8")
    return secret


def keychain_write(service: str, secret: str, label: str) -> None:
    """Written as hex via -X.

    Batch mode (`security -i`) looks safer — the secret would stay off the argument
    list — but it wraps long lines and then reports each fragment as an unknown
    command, printing the credential to the terminal. Real blobs are ~8 KB, so that
    fires every time. Argument passing is the mechanism that actually works; the
    residual exposure is a few milliseconds in this user's own process list.
    """
    result = run(
        [
            "security",
            "add-generic-password",
            "-U",
            "-a",
            CLAUDE_KEYCHAIN_ACCOUNT,
            "-s",
            service,
            "-l",
            label,
            "-X",
            secret.encode("utf-8").hex(),
        ]
    )
    if result.returncode != 0:
        raise Fail(f"keychain write failed for {service}: {diagnose(result, secret)}")
    if keychain_read(service) != secret:
        raise Fail(f"keychain write for {service} did not round-trip; nothing was switched")


def keychain_delete(service: str) -> None:
    """Loop: a service can hold duplicates, and a silent failure would strand a token."""
    while True:
        result = run(
            [
                "security",
                "delete-generic-password",
                "-s",
                service,
                "-a",
                CLAUDE_KEYCHAIN_ACCOUNT,
            ]
        )
        if result.returncode == ITEM_NOT_FOUND:
            return
        if result.returncode != 0:
            raise Fail(f"keychain delete failed for {service}: {diagnose(result)}")


def profile_service(profile: str) -> str:
    return f"accsw-claude-{profile}"


def read_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise Fail(f"{path} is not valid JSON: {error}")
    except OSError as error:
        raise Fail(f"cannot read {path}: {error}")


def load_registry() -> dict:
    if not REGISTRY.is_file():
        return {"profiles": {}, "active": {}}
    return read_json(REGISTRY)


def save_registry(registry: dict) -> None:
    STORE.mkdir(parents=True, exist_ok=True)
    STORE.chmod(0o700)
    atomic_write(REGISTRY, json.dumps(registry, indent=2) + "\n")


def running(tool: str) -> list[int]:
    pids: set[int] = set()
    for name in PROCESS_NAMES[tool]:
        result = run(["pgrep", "-x", name])
        if result.returncode == 0:
            pids.update(int(line) for line in result.stdout.split() if line.isdigit())
    return sorted(pids)


# ------------------------------------------------------------------ identity


def claude_identity() -> str | None:
    account = claude_oauth_account()
    return account.get("emailAddress") if account else None


def codex_identity() -> str | None:
    """Read the email claim out of the stored id_token. The token is never printed."""
    if not CODEX_AUTH.is_file():
        return None
    payload = read_json(CODEX_AUTH)
    # `tokens` is present but null in API-key mode, so `.get("tokens", {})` is not enough.
    token = (payload.get("tokens") or {}).get("id_token") or payload.get("id_token")
    if not isinstance(token, str) or token.count(".") != 2:
        return None
    import base64

    body = token.split(".")[1]
    body += "=" * (-len(body) % 4)
    try:
        claims = json.loads(base64.urlsafe_b64decode(body))
    except (ValueError, json.JSONDecodeError):
        return None
    return claims.get("email")


def claude_oauth_account() -> dict | None:
    if not CLAUDE_STATE.is_file():
        return None
    account = read_json(CLAUDE_STATE).get("oauthAccount")
    return account if isinstance(account, dict) else None


def set_claude_oauth_account(account: dict) -> None:
    """Rewrite only the oauthAccount key; the rest of .claude.json is workspace state."""
    if not CLAUDE_STATE.is_file():
        raise Fail(f"{CLAUDE_STATE} does not exist — run Claude Code once before switching")
    state = read_json(CLAUDE_STATE)
    state["oauthAccount"] = account
    atomic_write(CLAUDE_STATE, json.dumps(state, indent=2) + "\n")


# ------------------------------------------------------------------ capture


def slugify(text: str) -> str:
    cleaned = "".join(char if char.isalnum() else "-" for char in text.lower())
    return "-".join(part for part in cleaned.split("-") if part)


def name_for(email: str, tool: str, registry: dict) -> str:
    """The profile an account belongs in: its own, or a free name derived from its address."""
    local, _, domain = email.partition("@")
    candidates = [slugify(local)]
    if domain:
        candidates.append(f"{slugify(local)}-{slugify(domain.split('.')[0])}")
    for name in candidates:
        owner = registry["profiles"].get(name, {}).get(tool, {}).get("email")
        if owner is None or owner == email:
            return name
    base = candidates[-1]
    suffix = 2
    while f"{base}-{suffix}" in registry["profiles"]:
        suffix += 1
    return f"{base}-{suffix}"


def derive_profile(registry: dict) -> tuple[str, str]:
    """Name a profile after whichever account is logged in, so nothing has to be invented.

    Claude wins when both are present: the two tools switch together, so the pair is
    stored under one name rather than split across two.
    """
    for tool in TOOLS:
        email = LIVE_IDENTITY[tool]()
        if email:
            return name_for(email, tool, registry), email
    raise Fail(
        "nothing is logged in — run `claude` or `codex login` first, "
        "or name a profile explicitly"
    )


def live_blob(tool: str) -> str | None:
    if tool == "claude":
        return keychain_read(CLAUDE_KEYCHAIN_SERVICE)
    return read_file(CODEX_AUTH)


def parked_blob(tool: str, profile: str) -> str | None:
    if tool == "claude":
        return keychain_read(profile_service(profile))
    return read_file(CODEX_VAULT / f"{profile}.json")


def absorb_live(registry: dict) -> list[str]:
    """Park whatever is signed in right now, under a name derived from the account.

    This runs before every command that touches the slot, which is why `save` is
    optional: a login made outside accsw is picked up on its own, and a parked copy
    can never go stale behind a live session that keeps refreshing its token.
    Writes only when the parked bytes actually differ, so the common case is two
    cheap reads and nothing else.
    """
    if os.environ.get("ACCSW_ABSORB") == "0":
        return []
    absorbed = []
    for tool in TOOLS:
        email = LIVE_IDENTITY[tool]()
        if email is None:
            continue
        live = live_blob(tool)
        if live is None:
            continue
        name = name_for(email, tool, registry)
        recorded = registry["profiles"].get(name, {}).get(tool)
        # The shortcut needs BOTH halves: matching bytes in the locker and an entry
        # describing them. With only the first, `active` would name a profile that
        # `list` cannot show and `use` cannot restore.
        if recorded and parked_blob(tool, name) == live:
            registry.setdefault("active", {})[tool] = name
            continue
        CAPTURE[tool](name, registry, replace=True)
        absorbed.append(f"{tool}: {email} → {name}")
    return absorbed


def guard_rebind(profile: str, tool: str, registry: dict, email: str | None, replace: bool) -> None:
    known = registry["profiles"].get(profile, {}).get(tool)
    if not known or replace:
        return
    if known.get("email") and email and known["email"] != email:
        raise Fail(
            f"profile {profile!r} holds {known['email']} for {tool}, but {email} is logged in "
            "— pass --replace to rebind it"
        )


def capture_claude(profile: str, registry: dict, replace: bool = False) -> str:
    secret = keychain_read(CLAUDE_KEYCHAIN_SERVICE)
    if secret is None:
        raise Fail(
            "no Claude Code credential in the keychain — run `claude` and log in first"
        )
    account = claude_oauth_account()
    if account is None:
        raise Fail(
            "Claude Code has no oauthAccount in ~/.claude.json — start it once before capturing"
        )
    email = account.get("emailAddress")
    guard_rebind(profile, "claude", registry, email, replace)
    keychain_write(profile_service(profile), secret, f"accsw claude — {profile}")
    entry = registry["profiles"].setdefault(profile, {})
    entry["claude"] = {"email": email, "oauthAccount": account}
    registry.setdefault("active", {})["claude"] = profile
    return email or "unknown"


def capture_codex(profile: str, registry: dict, replace: bool = False) -> str:
    if not CODEX_AUTH.is_file():
        raise Fail(f"no Codex credential at {CODEX_AUTH} — run `codex login` first")
    email = codex_identity()
    guard_rebind(profile, "codex", registry, email, replace)
    CODEX_VAULT.mkdir(parents=True, exist_ok=True)
    CODEX_VAULT.chmod(0o700)
    atomic_write(CODEX_VAULT / f"{profile}.json", CODEX_AUTH.read_text(encoding="utf-8"))
    entry = registry["profiles"].setdefault(profile, {})
    entry["codex"] = {"email": email}
    registry.setdefault("active", {})["codex"] = profile
    return email or "unknown"


# ------------------------------------------------------------------ restore


def preflight_claude(profile: str, registry: dict) -> None:
    """Everything that must be true before a single byte is written."""
    stored = registry["profiles"].get(profile, {}).get("claude")
    if stored is None:
        raise Fail(f"profile {profile!r} has no captured Claude account")
    if not stored.get("oauthAccount"):
        raise Fail(
            f"profile {profile!r} was captured without its identity — "
            f"recapture it with `accsw save {profile} --tool claude --replace`"
        )
    secret = keychain_read(profile_service(profile))
    if secret is None:
        raise Fail(
            f"profile {profile!r} lost its keychain item — recapture with `accsw save {profile}`"
        )
    json.loads(secret)
    if not CLAUDE_STATE.is_file():
        raise Fail(f"{CLAUDE_STATE} does not exist — run Claude Code once before switching")
    read_json(CLAUDE_STATE)


def preflight_codex(profile: str, registry: dict) -> None:
    stored = registry["profiles"].get(profile, {}).get("codex")
    source = CODEX_VAULT / f"{profile}.json"
    if stored is None or not source.is_file():
        raise Fail(f"profile {profile!r} has no captured Codex account")
    read_json(source)


def restore_claude(profile: str, registry: dict) -> str:
    stored = registry["profiles"][profile]["claude"]
    secret = keychain_read(profile_service(profile))
    keychain_write(CLAUDE_KEYCHAIN_SERVICE, secret, "Claude Code")
    set_claude_oauth_account(stored["oauthAccount"])
    registry.setdefault("active", {})["claude"] = profile
    return stored.get("email") or "unknown"


def restore_codex(profile: str, registry: dict) -> str:
    stored = registry["profiles"][profile]["codex"]
    source = CODEX_VAULT / f"{profile}.json"
    atomic_write(CODEX_AUTH, source.read_text(encoding="utf-8"))
    registry.setdefault("active", {})["codex"] = profile
    return stored.get("email") or "unknown"


CAPTURE = {"claude": capture_claude, "codex": capture_codex}
RESTORE = {"claude": restore_claude, "codex": restore_codex}
PREFLIGHT = {"claude": preflight_claude, "codex": preflight_codex}
LIVE_IDENTITY = {"claude": claude_identity, "codex": codex_identity}


def load_state() -> dict:
    """The registry, with whatever is signed in already parked into it."""
    registry = load_registry()
    if absorb_live(registry):
        save_registry(registry)
    return registry


# -------------------------------------------------------------------- quota

CLAUDE_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
CODEX_PROFILE_URL = "https://chatgpt.com/backend-api/wham/profiles/me"
HTTP_TIMEOUT = 6

# Claude reports one window per scope; these are the ones worth showing.
CLAUDE_WINDOWS = {
    "five_hour": "5h",
    "seven_day": "7d",
}


def http_get_json(url: str, token: str) -> dict:
    """GET with a bearer token, refusing redirects.

    urllib copies every header onto a redirected request without comparing hosts, so
    following one would hand a live access token to whatever host answered.
    """
    import urllib.error
    import urllib.request

    class RefuseRedirects(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *arguments, **keywords):
            return None

    request = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "Accept": "application/json",
        },
    )
    try:
        opener = urllib.request.build_opener(RefuseRedirects)
        with opener.open(request, timeout=HTTP_TIMEOUT) as response:
            return json.loads(response.read())
    except urllib.error.HTTPError as error:
        if error.code in (401, 403):
            raise Fail("token expired — switch to this account once to refresh it")
        if 300 <= error.code < 400:
            raise Fail(f"refused a {error.code} redirect — the token stays on this host")
        raise Fail(f"HTTP {error.code}")
    except urllib.error.URLError as error:
        raise Fail(f"unreachable ({error.reason})")
    except json.JSONDecodeError:
        raise Fail("response was not JSON")


def parse_epoch(value) -> int | None:
    """Windows report their reset as epoch seconds, epoch millis, or ISO-8601."""
    if isinstance(value, (int, float)):
        return int(value / 1000) if value > 1e12 else int(value)
    if isinstance(value, str):
        from datetime import datetime

        try:
            return int(datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp())
        except ValueError:
            return None
    return None


def claude_access_token(blob: str | None) -> str:
    if blob is None:
        raise Fail("no stored credential")
    token = json.loads(blob).get("claudeAiOauth", {}).get("accessToken")
    if not token:
        raise Fail("credential has no access token")
    return token


def codex_access_token(document: str | None) -> str:
    if document is None:
        raise Fail("no stored credential")
    payload = json.loads(document)
    token = (payload.get("tokens") or {}).get("access_token") or payload.get("access_token")
    if not token:
        raise Fail("credential has no access token (API-key mode has no usage window)")
    return token


def read_file(path: Path) -> str | None:
    return path.read_text(encoding="utf-8") if path.is_file() else None


def profile_token(tool: str, profile: str) -> str:
    if tool == "claude":
        return claude_access_token(keychain_read(profile_service(profile)))
    return codex_access_token(read_file(CODEX_VAULT / f"{profile}.json"))


def live_token(tool: str) -> str:
    if tool == "claude":
        return claude_access_token(keychain_read(CLAUDE_KEYCHAIN_SERVICE))
    return codex_access_token(read_file(CODEX_AUTH))


def claude_quota(token: str) -> list[tuple[str, float, int | None]]:
    payload = http_get_json(CLAUDE_USAGE_URL, token)
    windows = []
    for key, label in CLAUDE_WINDOWS.items():
        window = payload.get(key)
        if not isinstance(window, dict):
            continue
        percent = window.get("utilization", window.get("percent"))
        if percent is None:
            continue
        windows.append((label, float(percent), parse_epoch(window.get("resets_at"))))
    return windows


def codex_quota(token: str) -> list[tuple[str, float, int | None]]:
    """Codex has no free quota endpoint.

    `wham/profiles/me` returns lifetime stats — tokens, streaks — and no limits.
    The real numbers (`RateLimitWindow { used_percent, window_minutes, resets_at }`)
    reach the client as a streamed event during an actual turn, so reading them
    would mean paying for a completion. We do not do that behind your back; Codex
    simply has no quota to show until OpenAI exposes one.
    """
    payload = http_get_json(CODEX_PROFILE_URL, token)
    limits = payload.get("rateLimits") or {}
    if not limits:
        raise Fail("no quota endpoint — Codex only reports limits during a live turn")
    windows = []
    for key, label in (("primary", "5h"), ("secondary", "7d")):
        window = limits.get(key)
        if not isinstance(window, dict):
            continue
        minutes = window.get("windowDurationMins")
        if isinstance(minutes, (int, float)):
            label = f"{int(minutes / 60)}h" if minutes < 1440 else f"{int(minutes / 1440)}d"
        windows.append(
            (label, float(window.get("usedPercent", 0.0)), parse_epoch(window.get("resetsAt")))
        )
    return windows


QUOTA = {"claude": claude_quota, "codex": codex_quota}


def gather_quota(registry: dict, tools: tuple[str, ...] = TOOLS) -> dict[tuple[str, str], object]:
    """Query every captured account, one at a time. Values are window lists or Fail.

    Sequential on purpose: a burst of simultaneous authenticated requests for several
    different accounts from one address is exactly the shape anti-abuse systems act on.
    """
    jobs = [
        (name, tool)
        for name, entry in registry["profiles"].items()
        for tool in tools
        if tool in entry
    ]
    snapshot = {}
    for position, (name, tool) in enumerate(jobs):
        if position:
            time.sleep(0.15)
        try:
            snapshot[(name, tool)] = QUOTA[tool](profile_token(tool, name))
        except Fail as error:
            snapshot[(name, tool)] = error
        except Exception as error:  # a quota probe must never take the switcher down
            snapshot[(name, tool)] = Fail(f"unexpected response ({type(error).__name__})")
    return snapshot


def effective_percent(percent: float, resets_at: int | None) -> float:
    """A window past its reset has rolled over, whatever the stored number says."""
    if resets_at is not None and resets_at <= int(time.time()):
        return 0.0
    return percent


def bar(percent: float, width: int = 10) -> str:
    filled = round(min(max(percent, 0.0), 100.0) / 100 * width)
    return "█" * filled + "░" * (width - filled)


def humanize_reset(timestamp: int | None) -> str:
    if timestamp is None:
        return ""
    from datetime import datetime

    delta = timestamp - int(time.time())
    if delta <= 0:
        return "now"
    hours, minutes = divmod(delta // 60, 60)
    days, hours = divmod(hours, 24)
    if days >= 1:
        return f"{days}d {hours}h" if hours else f"{days}d"
    if hours >= 1:
        return f"{hours}h {minutes}m" if minutes else f"{hours}h"
    return f"{minutes}m"


def format_quota(result) -> str:
    if isinstance(result, Fail):
        return f"— {result}"
    if not result:
        return "— no window reported"
    parts = []
    for label, percent, resets_at in result:
        left = 100.0 - effective_percent(percent, resets_at)
        countdown = humanize_reset(resets_at) or "now"
        parts.append(f"{label} {bar(left, 6)} {left:>3.0f}% {countdown}")
    return "   ".join(parts)


def paint(text: str, code: str, enabled: bool) -> str:
    return f"{ESC}[{code}m{text}{ESC}[0m" if enabled else text


def remaining_colour(left: float) -> str:
    if left >= 50:
        return "32"
    return "33" if left >= 20 else "31"


def quota_lines(result, colour: bool) -> list[str]:
    """One aligned line per window, coloured by how much is left."""
    if isinstance(result, Fail):
        return [paint(f"— {result}", "31", colour)]
    if not result:
        return ["— no window reported"]
    lines = []
    for label, percent, resets_at in result:
        left = 100.0 - effective_percent(percent, resets_at)
        countdown = humanize_reset(resets_at)
        when = f"resets in {countdown}" if countdown else "just reset"
        lines.append(
            f"{label:<3} {paint(bar(left), remaining_colour(left), colour)} "
            f"{left:>3.0f}% left   {paint(when, '2', colour)}"
        )
    return lines


def headroom(result) -> float | None:
    """Free capacity in the most-constrained window. None when unknown."""
    if isinstance(result, Fail) or not result:
        return None
    return 100.0 - max(effective_percent(percent, at) for _, percent, at in result)


# ------------------------------------------------------------------- picker

ESC = "\x1b"


def read_key(fd: int) -> str:
    import select

    char = os.read(fd, 1).decode(errors="ignore")
    if char != ESC:
        return char
    if not select.select([fd], [], [], 0.05)[0]:
        return "escape"
    sequence = os.read(fd, 2).decode(errors="ignore")
    return {"[A": "up", "[B": "down"}.get(sequence, "escape")


def draw(entries: list[list[str]], index: int, redraw: bool) -> None:
    width = shutil.get_terminal_size((100, 24)).columns - 4
    if redraw:
        sys.stdout.write(f"{ESC}[{sum(len(lines) for lines in entries)}A")
    for position, lines in enumerate(entries):
        selected = position == index
        for offset, line in enumerate(lines):
            marker = "❯" if selected and offset == 0 else " "
            body = line[:width]
            style = f"{ESC}[7m" if selected else f"{ESC}[2m"
            sys.stdout.write(f"{ESC}[2K {marker} {style} {body} {ESC}[0m\r\n")
    sys.stdout.flush()


def choose(entries: list[list[str]], start: int) -> int | str | None:
    """Inline picker over multi-line entries. Returns an index, "auto", or None."""
    import termios
    import tty

    if not sys.stdin.isatty():
        raise Fail("not a terminal — name the profile explicitly, e.g. `accsw use perso`")

    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    index = start
    sys.stdout.write(f"{ESC}[?25l")
    try:
        tty.setraw(fd)
        draw(entries, index, redraw=False)
        while True:
            key = read_key(fd)
            if key in ("up", "k"):
                index = (index - 1) % len(entries)
            elif key in ("down", "j"):
                index = (index + 1) % len(entries)
            elif key in ("\r", "\n"):
                return index
            elif key == "a":
                return "auto"
            elif key in ("q", "escape", "\x03"):
                return None
            else:
                continue
            draw(entries, index, redraw=True)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        sys.stdout.write(f"{ESC}[?25h")
        sys.stdout.flush()


def profile_lines(
    name: str, entry: dict, active: dict, quota: dict, width: int
) -> list[str]:
    lines = []
    for tool in TOOLS:
        if tool not in entry:
            continue
        mark = "●" if active.get(tool) == name else "○"
        head = f"{name:<{width}}" if not lines else " " * width
        email = (entry[tool].get("email") or "unknown")[:26]
        lines.append(
            f"{head}  {mark} {tool:<7} {email:<26} {format_quota(quota.get((name, tool)))}"
        )
    return lines or [f"{name:<{width}}  (nothing captured)"]


def best_profile(
    registry: dict, quota: dict, tools: tuple[str, ...] = TOOLS
) -> tuple[str | None, str]:
    """The account whose most-constrained window is least used. Ties keep the active one."""
    active = registry.get("active", {})
    scored = []
    for name, entry in registry["profiles"].items():
        margins = [headroom(quota.get((name, tool))) for tool in tools if tool in entry]
        known = [margin for margin in margins if margin is not None]
        if not known:
            continue
        loaded = any(active.get(tool) == name for tool in tools)
        scored.append((min(known), loaded, name))
    if not scored:
        return None, "no account reported usable quota"
    scored.sort(key=lambda row: (-row[0], not row[1], row[2]))
    margin, _, name = scored[0]
    return name, f"{margin:.0f}% left in its tightest window"


def pick_profile(registry: dict) -> str | None:
    profiles = registry["profiles"]
    if not profiles:
        raise Fail("no profiles yet — capture the current login with `accsw save <name>`")
    active = registry.get("active", {})
    names = sorted(profiles)
    width = max(len(name) for name in names)

    print("reading quota…", end="", flush=True)
    quota = gather_quota(registry)
    print(f"\r{ESC}[2Kswitch account   ↑↓ move   ↵ select   a auto   q cancel")

    entries = [profile_lines(name, profiles[name], active, quota, width) for name in names]
    current = next((i for i, name in enumerate(names) if active.get("claude") == name), 0)

    chosen = choose(entries, current)
    if chosen is None:
        print("cancelled")
        return None
    if chosen == "auto":
        name, why = best_profile(registry, quota)
        if name is None:
            raise Fail(why)
        print(f"auto-picked {name} — {why}")
        return name
    return names[chosen]


# ----------------------------------------------------------------- commands


def selected_tools(args) -> tuple[str, ...]:
    return (args.tool,) if args.tool else TOOLS


def warn_running(tools: tuple[str, ...]) -> None:
    """Warn, never block.

    IDE extensions keep a host process alive for as long as the editor is open, so
    "is it running" is nearly always yes and a hard block would just train you to
    bypass it. The real consequence is bounded: a live session keeps working on its
    in-memory token, but when it refreshes it rewrites the shared credential slot, so
    the next process to start may pick up the account you just switched away from.
    """
    busy = {tool: running(tool) for tool in tools}
    busy = {tool: pids for tool, pids in busy.items() if pids}
    if not busy:
        return
    listed = ", ".join(f"{len(pids)} {tool}" for tool, pids in busy.items())
    note(f"{listed} already running — they may rewrite the slot when their token refreshes")


def apply_switch(profile: str, tools: tuple[str, ...], registry: dict) -> list[str]:
    """Preflight every leg, then swap them one at a time, recording each as it lands."""
    for tool in tools:
        PREFLIGHT[tool](profile, registry)

    outcome = []
    for tool in tools:
        if registry.get("active", {}).get(tool) == profile:
            outcome.append(f"{tool}: already loaded")
            continue
        email = RESTORE[tool](profile, registry)
        save_registry(registry)
        outcome.append(f"{tool}: {email}")
    return outcome


def cmd_save(args) -> int:
    registry = load_state()
    if args.profile is None:
        args.profile, discovered = derive_profile(registry)
        print(f"found {discovered} logged in — capturing as {args.profile!r}")
    tools = selected_tools(args)
    saved = []
    skipped = []
    for tool in tools:
        try:
            email = CAPTURE[tool](args.profile, registry, args.replace)
            saved.append(f"{tool}: {email}")
        except Fail as error:
            if args.tool:
                raise
            skipped.append(f"skipped {tool} — {error}")
    if not saved:
        raise Fail("; ".join(skipped) or "nothing captured")
    save_registry(registry)
    print(f"saved profile {args.profile!r}")
    for line in saved + skipped:
        print(f"  {line}")
    return 0


def cmd_use(args) -> int:
    registry = load_state()
    if args.profile is None:
        args.profile = pick_profile(registry)
        if args.profile is None:
            return 0
    elif args.profile not in registry["profiles"]:
        raise Fail(f"unknown profile {args.profile!r} — see `accsw list`")
    wanted = selected_tools(args)
    entry = registry["profiles"][args.profile]
    tools = tuple(tool for tool in wanted if tool in entry)
    if not tools:
        raise Fail(f"profile {args.profile!r} holds no account for {', '.join(wanted)}")
    warn_running(tools)
    switched = apply_switch(args.profile, tools, registry)
    print(f"switched to {args.profile!r}")
    for line in switched:
        print(f"  {line}")
    return 0


def cmd_run(args) -> int:
    """Pick the roomiest account, switch to it, then become the tool."""
    tool = args.tool_name
    registry = load_state()
    binary = shutil.which(tool)
    if binary is None:
        raise Fail(f"{tool} is not on PATH")

    if not registry["profiles"]:
        note("no profiles captured yet — run `accsw save`")
    else:
        quota = gather_quota(registry, (tool,))
        name, why = best_profile(registry, quota, (tool,))
        if name is None:
            note(f"{why} — staying on the loaded account")
        elif registry.get("active", {}).get(tool) == name:
            note(f"{tool} already on {name} — {why}")
        else:
            warn_running((tool,))
            apply_switch(name, (tool,), registry)
            note(f"switched {tool} to {name} — {why}")

    os.execv(binary, [binary, *args.rest])


def note(message: str) -> None:
    """Chatter from the wrapper goes to stderr so it never pollutes piped output."""
    print(f"accsw: {message}", file=sys.stderr)


def cmd_list(args) -> int:
    registry = load_state()
    profiles = registry["profiles"]
    if not profiles:
        print("no profiles yet — capture the current login with `accsw save <name>`")
        return 0
    active = registry.get("active", {})
    width = max(len(name) for name in profiles)
    for name, entry in sorted(profiles.items()):
        marks = []
        for tool in TOOLS:
            if tool not in entry:
                continue
            flag = "*" if active.get(tool) == name else " "
            marks.append(f"{flag}{tool}: {entry[tool].get('email') or 'unknown'}")
        print(f"{name:<{width}}  " + "   ".join(marks))
    print("\n* = currently loaded")
    return 0


def cmd_status(args) -> int:
    registry = load_state()
    active = registry.get("active", {})
    colour = sys.stdout.isatty()
    for position, tool in enumerate(TOOLS):
        if position:
            print()
        live = LIVE_IDENTITY[tool]()
        aside = []
        if active.get(tool):
            aside.append(active[tool])
        processes = running(tool)
        if processes:
            # Mostly IDE extension hosts and the desktop app, not chat sessions.
            aside.append(f"{len(processes)} processes")
        tail = paint("   " + " · ".join(aside), "2", colour) if aside else ""
        print(f"{tool:<7} {live or paint('not signed in', '2', colour)}{tail}")
        if live is None:
            continue
        try:
            windows = QUOTA[tool](live_token(tool))
        except Fail as error:
            print(f"        {paint(f'— {error}', '31', colour)}")
            continue
        for line in quota_lines(windows, colour):
            print(f"        {line}")
    return 0


def cmd_auto(args) -> int:
    registry = load_state()
    if not registry["profiles"]:
        raise Fail("no profiles yet — capture the current login with `accsw save <name>`")
    tools = selected_tools(args)
    quota = gather_quota(registry)
    name, why = best_profile(registry, quota, tools)
    if name is None:
        raise Fail(why)
    active = registry.get("active", {})
    if all(active.get(tool) == name for tool in tools if tool in registry["profiles"][name]):
        print(f"already on {name!r} — {why}")
        return 0
    args.profile = name
    print(f"auto-picked {name!r} — {why}")
    return cmd_use(args)


def cmd_rm(args) -> int:
    registry = load_registry()
    if args.profile not in registry["profiles"]:
        raise Fail(f"unknown profile {args.profile!r}")
    if args.profile in registry.get("active", {}).values() and not args.yes:
        raise Fail(
            f"{args.profile!r} is the profile currently loaded — forgetting it drops the only "
            "parked copy of that token. Switch elsewhere first, or pass --yes."
        )
    keychain_delete(profile_service(args.profile))
    stored_codex = CODEX_VAULT / f"{args.profile}.json"
    if stored_codex.is_file():
        stored_codex.unlink()
    del registry["profiles"][args.profile]
    for tool, name in list(registry.get("active", {}).items()):
        if name == args.profile:
            del registry["active"][tool]
    save_registry(registry)
    print(f"removed profile {args.profile!r} (the live login is untouched)")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="accsw", description=__doc__.splitlines()[0])
    subparsers = parser.add_subparsers(dest="command")
    parser.set_defaults(handler=cmd_use, profile=None, tool=None)

    tool_flag = dict(choices=TOOLS, help="act on one tool only (default: both)")

    save = subparsers.add_parser("save", help="capture the currently logged-in account")
    save.add_argument(
        "profile", nargs="?", help="omit to name it after whoever is logged in"
    )
    save.add_argument("--tool", **tool_flag)
    save.add_argument(
        "--replace",
        action="store_true",
        help="rebind the profile even if a different account is logged in",
    )
    save.set_defaults(handler=cmd_save)

    use = subparsers.add_parser("use", help="switch to a captured account")
    use.add_argument("profile", nargs="?", help="omit to pick from a menu")
    use.add_argument("--tool", **tool_flag)
    use.set_defaults(handler=cmd_use)

    listing = subparsers.add_parser("list", help="list captured profiles")
    listing.set_defaults(handler=cmd_list)

    status = subparsers.add_parser("status", help="show who is logged in, with quota")
    status.set_defaults(handler=cmd_status)

    launch = subparsers.add_parser(
        "run", help="pick the roomiest account, switch to it, then launch the tool"
    )
    launch.add_argument("tool_name", choices=TOOLS)
    launch.add_argument("rest", nargs=argparse.REMAINDER, help="arguments passed through")
    launch.set_defaults(handler=cmd_run)

    auto = subparsers.add_parser("auto", help="switch to the account with the most headroom")
    auto.add_argument("--tool", **tool_flag)
    auto.set_defaults(handler=cmd_auto)

    remove = subparsers.add_parser("rm", help="forget a profile")
    remove.add_argument("profile")
    remove.add_argument(
        "--yes", action="store_true", help="forget it even if it is the loaded profile"
    )
    remove.set_defaults(handler=cmd_rm)

    args = parser.parse_args()
    try:
        return args.handler(args)
    except Fail as error:
        print(f"accsw: {error}", file=sys.stderr)
        return 1
    except (OSError, json.JSONDecodeError) as error:
        print(f"accsw: {type(error).__name__}: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\naccsw: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
