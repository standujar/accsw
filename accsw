# ChatGPT.app reads $CODEX_HOME/auth.json — the file a switch rewrites — so
# reopening it lands on the new account. No other app qualifies.
GUI_APPS = {"codex": "ChatGPT"}




def quit_app(name: str) -> None:
    if not app_running(name):
        return
    run(["osascript", "-e", f'tell application "{name}" to quit'])
    for _ in range(24):
        if not app_running(name):
            return
        time.sleep(0.25)
    raise Fail(f"{name} did not quit; it was left on its current account")






def app_running(name: str) -> bool:
    """Raises rather than guessing.

    Automation is gated behind a TCC grant, so a refusal comes back non-zero with
    empty output. Reading that as "not running" would let the caller relink — or
    rename — the support directory of an app that is very much running.
    """
    result = run(
        [
            "osascript",
            "-e",
            f'tell application "System Events" to (name of processes) contains "{name}"',
        ]
    )
    answer = result.stdout.strip()
    if result.returncode != 0 or answer not in ("true", "false"):
        raise Fail(
            f"cannot tell whether {name} is running: {diagnose(result)}. "
            "Grant Automation access to your terminal in System Settings → Privacy."
        )
    return answer == "true"


def restart_app(name: str) -> None:
    """Ask the app to quit — never kill it — then bring it back."""
    quit_app(name)
    run(["open", "-a", name])


def note(message: str) -> None:
    """Chatter goes to stderr so it never pollutes piped output."""
    print(f"accsw: {message}", file=sys.stderr)


def settle_readers(tools: tuple[str, ...]) -> None:
    """Reopen the desktop apps that read a credential we just swapped.

    Only ChatGPT.app qualifies: it reads $CODEX_HOME/auth.json, the very file that
    changed. Claude.app is left alone — it signs in with a web session accsw cannot
    produce, so closing it would cost you a window and give nothing back.
    """
    for tool in tools:
        name = GUI_APPS.get(tool)
        if name is None:
            continue
        if app_running(name):
            restart_app(name)
            note(f"reopened {name}")
        else:
            # It reads the slot we just wrote, so simply starting it is enough.
            run(["open", "-a", name])
            note(f"opened {name}")
    for tool in tools:
        if running(tool):
            hint = (
                " — reload the IDE window (Cmd-Shift-P → Reload Window)"
                if tool == "claude"
                else ""
            )
            # A new chat is not enough: the extension host caches the credential it
            # read at startup, so the window itself has to come back.
            note(f"open {tool} sessions keep the old account{hint}")



def apply_switch(profile: str, tools: tuple[str, ...], registry: dict) -> list[str]:
    """Preflight every leg, then swap them one at a time, recording each as it lands."""
    for tool in tools:
        PREFLIGHT[tool](profile, registry)

    outcome = []
    for tool in tools:
        if actually_loaded(tool, registry) == profile:
            outcome.append("already loaded")
            continue
        email = RESTORE[tool](profile, registry)
        save_registry(registry)
        outcome.append(email)
    return outcome








def shared_email(entry: dict) -> str | None:
    """The one address behind a profile, or None when its tools disagree.

    A profile is named after the address it holds, so both tools normally carry the
    same one and printing it twice is noise. They can still differ if a registry was
    hand-edited, and then each is shown on its own line.
    """
    seen = {entry[tool].get("email") for tool in TOOLS if tool in entry}
    return seen.pop() if len(seen) == 1 else None


def cmd_list(args) -> int:
    registry = load_state()
    profiles = registry["profiles"]
    if not profiles:
        print("no accounts yet — `accsw add claude` or `accsw add codex`")
        return 0
    active = registry.get("active", {})
    colour = sys.stdout.isatty()
    width = max(len(name) for name in profiles)
    emails = [
        len(entry[tool].get("email") or "unknown")
        for entry in profiles.values()
        for tool in TOOLS
        if tool in entry
    ]
    cell = max(emails, default=8)
    for name in sorted(profiles):
        one = shared_email(profiles[name])
        columns = []
        for tool in TOOLS:
            if tool not in profiles[name]:
                columns.append(" " * (len(tool) + 2))
                continue
            mark = paint("●", LOADED, colour) if active.get(tool) == name else paint("○", DIM, colour)
            flag = paint("!", "31", colour) if profiles[name][tool].get("needs_signin") else ""
            columns.append(f"{mark} {paint(tool, TOOL_COLOUR[tool], colour)}{flag}")
        address = one or "—"
        print(f"{name:<{width}}   {paint(f'{address:<{cell}}', DIM, colour)}  " + " ".join(columns))
        if one is None:
            for tool in TOOLS:
                if tool in profiles[name]:
                    print(
                        f"{'':<{width}}   {paint(tool, TOOL_COLOUR[tool], colour)} "
                        f"{paint(profiles[name][tool].get('email') or 'unknown', DIM, colour)}"
                    )
    return 0


def cmd_status(args) -> int:
    registry = load_state()
    profiles = registry["profiles"]
    if not profiles:
        print("no accounts captured yet — log in to one and run accsw")
        return 0
    active = registry.get("active", {})
    colour = sys.stdout.isatty()
    quota, ages = gather_quota(registry)
    # Written back, or the five-minute cache and the Retry-After backoff would last
    # exactly as long as this process and re-ask the moment you look again.
    save_registry(registry)
    # One width for the whole view: per-result widths made Claude's bars, which sit
    # behind a five-letter model name, start further right than Codex's.
    labels = [
        len(label)
        for result in quota.values()
        if not isinstance(result, Fail)
        for label, _, _ in result
    ]
    width = max(labels, default=2)
    order = sorted(
        profiles,
        # Roomiest first; accounts whose quota could not be read sit at the end,
        # where they cannot be mistaken for empty ones.
        key=lambda name: (availability(name, profiles[name], quota) is None,
                          -(availability(name, profiles[name], quota) or 0.0),
                          name),
    )
    for position, name in enumerate(order):
        if position:
            print()
        loaded = [tool for tool in TOOLS if active.get(tool) == name]
        title = paint(name, BOLD, colour) if loaded else name
        tag = paint("  in use", LOADED, colour) if loaded else ""
        # Naming the constraint rather than averaging it away: an account can read
        # 2% "free" while its 5h window is untouched, because one model's cap is
        # spent. That number is true and says the wrong thing.
        binding = []
        for tool in TOOLS:
            if tool not in profiles[name]:
                continue
            window = deciding_window(quota.get((name, tool)), tool)
            if window:
                binding.append(f"{tool} {window[0]} {window[1]:.0f}%")
        share = paint("   " + "   ".join(binding), DIM, colour) if binding else ""
        one = shared_email(profiles[name])
        address = paint(f"   {one}", DIM, colour) if one else ""
        print(f"{title}{address}{tag}{share}")
        for tool in TOOLS:
            if tool not in profiles[name]:
                continue
            here = active.get(tool) == name
            mark = paint("●", LOADED, colour) if here else paint("○", DIM, colour)
            email = profiles[name][tool].get("email") or "unknown"
            flag = (
                paint("  sign-in needed", "31", colour)
                if profiles[name][tool].get("needs_signin")
                else ""
            )
            label = f"{tool:<7}" if not one else tool
            shown = "" if one else f" {paint(email, DIM, colour)}"
            print(f"  {mark} {paint(label, TOOL_COLOUR[tool], colour)}{shown}{flag}")
            age = ages.get((name, tool))
            for line in quota_lines(quota.get((name, tool)), colour, width):
                print(f"      {line}")
            if age is not None:
                print(f"      {paint(f'(rate limited — figures from {humanize_reset(int(time.time()) + age)} ago)', '2', colour)}")

    return 0


AGENT_LABEL = "com.standujar.accsw"
AGENT_PLIST = HOME / "Library" / "LaunchAgents" / f"{AGENT_LABEL}.plist"
RENEW_EVERY = 1800


def ensure_agent(registry: dict) -> bool:
    """Offer the renewal agent once, and take no for an answer.

    Without it, keeping sign-ins alive depends on you happening to run accsw often
    enough — and the one time you do not is the one time an account dies. But it is
    a permanent thing to leave on someone's machine, so it is asked for, once, and
    the refusal is remembered.
    """
    if AGENT_PLIST.exists() or registry.get("agent") == "declined":
        return False
    if not sys.stdin.isatty():
        return False
    print("\nSign-ins lapse if nothing refreshes them, and a lapsed one costs a browser login.")
    print(f"Install an agent that refreshes them every {RENEW_EVERY // 60} minutes? "
          "It switches nothing.  [Y/n] ", end="")
    answer = input().strip().lower()
    if answer and not answer.startswith("y"):
        registry["agent"] = "declined"
        save_registry(registry)
        note("not installed — `accsw --renew` does the same thing when you run it")
        return False
    try:
        install_agent()
    except Fail as error:
        note(str(error))
        return False
    return True


def remove_agent() -> bool:
    if not AGENT_PLIST.exists():
        return False
    run(["launchctl", "unload", str(AGENT_PLIST)])
    AGENT_PLIST.unlink()
    return True


def install_agent() -> None:
    binary = Path(sys.argv[0]).resolve()
    AGENT_PLIST.parent.mkdir(parents=True, exist_ok=True)
    AGENT_PLIST.write_text(
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" '
        '"http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
        '<plist version="1.0"><dict>\n'
        f"  <key>Label</key><string>{AGENT_LABEL}</string>\n"
        "  <key>ProgramArguments</key>\n"
        f"  <array><string>{sys.executable}</string><string>{binary}</string>"
        "<string>--renew</string></array>\n"
        f"  <key>StartInterval</key><integer>{RENEW_EVERY}</integer>\n"
        "  <key>RunAtLoad</key><true/>\n"
        f"  <key>StandardOutPath</key><string>{STORE / 'renew.log'}</string>\n"
        f"  <key>StandardErrorPath</key><string>{STORE / 'renew.log'}</string>\n"
        "</dict></plist>\n",
        encoding="utf-8",
    )
    run(["launchctl", "unload", str(AGENT_PLIST)])
    result = run(["launchctl", "load", str(AGENT_PLIST)])
    if result.returncode != 0:
        AGENT_PLIST.unlink(missing_ok=True)
        raise Fail(f"could not install the renewal agent: {diagnose(result)}")


def cmd_agent(args) -> int:
    registry = load_registry()
    if args.agent == "off":
        registry["agent"] = "declined"
        save_registry(registry)
        colour = sys.stdout.isatty()
        print(paint("removed" if remove_agent() else "no agent was installed", DIM, colour))
        return 0
    install_agent()
    registry.pop("agent", None)
    save_registry(registry)
    colour = sys.stdout.isatty()
    print(f"{paint('●', LOADED, colour)} renewal agent installed")
    print(paint(f"  every {RENEW_EVERY // 60} minutes, switches nothing", DIM, colour))
    print(paint(f"  log: {STORE / 'renew.log'}", DIM, colour))
    return 0


def resolve_account(term: str, tool: str, registry: dict) -> str:
    """The profile a name or an address refers to.

    Either identifies an account, because either is how you think of it: the alias
    accsw derived, or the address you actually signed in with. Prefixes are accepted
    while they are unambiguous, and an ambiguous one names its candidates rather than
    picking for you — switching to the wrong account is not a small mistake here.
    """
    holders = {
        name: (entry[tool].get("email") or "")
        for name, entry in registry["profiles"].items()
        if tool in entry
    }
    if not holders:
        raise Fail(f"no account is captured for {tool} — `accsw add {tool}`")
    wanted = term.lower()
    for name, email in holders.items():
        if wanted in (name.lower(), email.lower()):
            return name
    near = [
        name
        for name, email in holders.items()
        if name.lower().startswith(wanted)
        or email.lower().startswith(wanted)
        or email.split("@")[0].lower() == wanted
    ]
    if len(near) == 1:
        return near[0]
    if not near:
        listed = ", ".join(sorted(holders))
        # Say what the word is for: the first one after the tool is always the
        # account, so `accsw codex exec …` lands here and the reason is not obvious.
        raise Fail(
            f"no {tool} account matches {term!r} — the word after `{tool}` names the "
            f"account, and anything after that goes to {tool}. Have: {listed}"
        )
    raise Fail(f"{term!r} matches several: {', '.join(sorted(near))}")


def cmd_launch(args) -> int:
    """Put one tool on a named account, then become that tool.

    `accsw codex work` runs codex on the work account; without a name it picks the
    one with the most left, the same way a bare `accsw` does.
    """
    tool = args.tool_name
    registry = load_state()
    binary = shutil.which(tool)
    if binary is None:
        raise Fail(f"{tool} is not on PATH")

    if args.account:
        name = resolve_account(args.account, tool, registry)
        why = "asked for"
    else:
        quota, _ = gather_quota(registry, (tool,))
        save_registry(registry)
        name, why = best_profile(registry, quota, tool)
        if name is None:
            raise Fail(why)

    colour = sys.stdout.isatty()
    if actually_loaded(tool, registry) == name:
        note(f"{tool} is already on {name}")
    else:
        apply_switch(name, (tool,), registry)
        note(
            f"{paint(tool, TOOL_COLOUR[tool], colour)} → "
            f"{paint(name, BOLD, colour)} {paint(f'({why})', DIM, colour)}"
        )
        settle_readers((tool,))
    os.execv(binary, [binary, *args.rest])


def cmd_renew(args) -> int:
    """Keep every account alive and change nothing else.

    What the background agent runs. It must never switch or reopen anything: a job
    that moves you off your account while you are working is worse than an expired
    credential, which is merely a renewal away.
    """
    # Without absorbing: absorbing can install a newer parked copy into the live
    # slot, and this command promises to change nothing you are using.
    registry = load_state(absorb=False)
    kept = renew_parked(registry)
    save_registry(registry)
    colour = sys.stdout.isatty()
    stamp = paint(datetime.datetime.now().strftime("%H:%M"), DIM, colour)
    if not kept:
        print(f"{stamp}  {paint('every sign-in has time left', DIM, colour)}")
        return 0
    print(f"{stamp}  {len(kept)} touched")
    for line in kept:
        name, _, reason = line.partition(": ")
        if reason:
            print(f"  {paint('✗', '31', colour)} {name:<28} {paint(reason, DIM, colour)}")
        else:
            print(f"  {paint('●', LOADED, colour)} {name}")
    return 0


def cmd_auto(args) -> int:
    """Choose per tool. The two credential slots are independent, and an account that
    only exists for one of them must never decide the other."""
    registry = load_state()
    if not registry["profiles"]:
        raise Fail("no accounts captured yet — log in to one and run accsw")
    if ensure_agent(registry):
        note(f"installed a renewal agent so sign-ins cannot lapse "
             f"(remove: launchctl unload {AGENT_PLIST} && rm {AGENT_PLIST})")
    kept = renew_parked(registry)
    if kept:
        save_registry(registry)
        note(f"renewed while idle: {', '.join(kept)}")
    tools = TOOLS
    quota, _ = gather_quota(registry, tools)
    for tool in tools:
        name, why = best_profile(registry, quota, tool)
        if name is None:
            note(f"{tool}: {why}")
            continue
        colour = sys.stdout.isatty()
        if actually_loaded(tool, registry) == name:
            # Nothing changed, so nothing is bounced. Bouncing a window to land on the
            # account it is already on is pure interruption — and when every account is
            # spent, that is every single run. The link is still checked, because it
            # costs nothing and decides where a Dock launch lands.
            print(
                f"  {paint(f'{tool:<7}', TOOL_COLOUR[tool], colour)} {paint('·', DIM, colour)} "
                f"{name:<26} {paint(why, DIM, colour)}"
            )
            continue
        outcome = apply_switch(name, (tool,), registry)
        print(
            f"  {paint(f'{tool:<7}', TOOL_COLOUR[tool], colour)} {paint('→', LOADED, colour)} "
            f"{paint(f'{name:<26}', BOLD, colour)} {paint(why, DIM, colour)}"
        )
        for line in outcome:
            if line != "already loaded":
                print(f"          {paint(line, DIM, colour)}")
        settle_readers((tool,))
    return 0


def claude_namespaced_service(directory: Path) -> str:
    """The keychain item a login writes when CLAUDE_SECURESTORAGE_CONFIG_DIR is set.

    Taken from the binary: the base name gains a suffix of the first eight hex
    characters of sha256 over the NFC-normalised directory path.
    """
    import hashlib
    import unicodedata

    digest = hashlib.sha256(
        unicodedata.normalize("NFC", str(directory)).encode("utf-8")
    ).hexdigest()[:8]
    return f"{CLAUDE_KEYCHAIN_SERVICE}-{digest}"


def cmd_add(args) -> int:
    """Sign in to another account beside the current one, and keep it.

    The login runs against a throwaway config directory, so the credential that is
    loaded right now is never touched — no logging out to log back in.
    """
    tool = args.tool_name
    registry = load_state()
    workspace = Path(tempfile.mkdtemp(prefix="accsw-add-"))
    try:
        return complete_add(args, tool, registry, workspace)
    finally:
        # The keychain item is named after this directory, so once it is gone the
        # item can never be addressed again. It goes first, and unconditionally.
        keychain_delete(claude_namespaced_service(workspace))
        # It holds a live credential the moment the sign-in succeeds, so it goes
        # whatever happens after — including the failures that raise past here.
        shutil.rmtree(workspace, ignore_errors=True)


def complete_add(args, tool: str, registry: dict, workspace: Path) -> int:
    print(f"signing in to a new {tool} account — the current one stays put\n")

    if tool == "codex":
        subprocess.run(["codex", "login"], env={**os.environ, "CODEX_HOME": str(workspace)})
        source = workspace / "auth.json"
        if not source.is_file():
            raise Fail("no credential was written — the sign-in did not complete")
        blob = source.read_text(encoding="utf-8")
        email = jwt_email((json.loads(blob).get("tokens") or {}).get("id_token"))
    else:
        service = claude_namespaced_service(workspace)
        subprocess.run(
            ["claude", "auth", "login"],
            env={**os.environ, "CLAUDE_SECURESTORAGE_CONFIG_DIR": str(workspace)},
        )
        blob = keychain_read(service)
        if blob is None:
            raise Fail("no credential was written — the sign-in did not complete")
        account = claude_oauth_identity(claude_access_token(blob))
        email = account["emailAddress"]

    if email is None:
        email = args.email
    if email is None:
        raise Fail(
            "signed in, but the account's address could not be read — "
            f"rerun with `accsw add {tool} --email you@example.com`"
        )

    name = name_for(email, tool, registry)
    registry["profiles"].setdefault(name, {}).pop(tool, None)
    if tool == "codex":
        CODEX_VAULT.mkdir(parents=True, exist_ok=True)
        CODEX_VAULT.chmod(0o700)
        atomic_write(CODEX_VAULT / f"{name}.json", blob)
        registry["profiles"].setdefault(name, {})["codex"] = {"email": email}
    else:
        keychain_write(profile_service(name), blob, f"accsw claude — {name}")
        registry["profiles"].setdefault(name, {})["claude"] = {
            "email": email,
            "oauthAccount": account,
        }
    save_registry(registry)
    print(f"\nadded {email} as {name!r} — `accsw` will use it when it has the most left")
    return 0




def main() -> int:
    parser = argparse.ArgumentParser(prog="accsw", description=__doc__.splitlines()[0])
    subparsers = parser.add_subparsers(dest="command")
    parser.add_argument(
        "--agent",
        choices=("on", "off"),
        help="install or remove the background renewal agent",
    )
    parser.add_argument(
        "--renew",
        action="store_const",
        const=cmd_renew,
        dest="handler",
        help="only keep the sign-ins alive; switch nothing (what the background agent runs)",
    )
    parser.set_defaults(handler=cmd_auto)





    for tool in TOOLS:
        launcher = subparsers.add_parser(
            tool, help=f"run {tool} on a given account (by alias or address)"
        )
        launcher.add_argument("account", nargs="?", help="alias or email; omit for the roomiest")
        launcher.add_argument("rest", nargs=argparse.REMAINDER, help="passed straight through")
        launcher.set_defaults(handler=cmd_launch, tool_name=tool)

    adding = subparsers.add_parser("add", help="sign in to another account and keep it")
    adding.add_argument("tool_name", choices=TOOLS)
    adding.add_argument("--email", help="the address, when it cannot be read back")
    adding.set_defaults(handler=cmd_add)

    listing = subparsers.add_parser("list", help="list captured profiles")
    listing.set_defaults(handler=cmd_list)

    status = subparsers.add_parser("status", help="show who is logged in, with quota")
    status.set_defaults(handler=cmd_status)




    args = parser.parse_args()
    if getattr(args, "agent", None):
        args.handler = cmd_agent
    try:
        try:
            lock = hold_lock()
        except Fail:
            # The background agent must stay silent about this: it will simply try
            # again on its next tick, and a log full of contention hides real faults.
            if args.handler is cmd_renew:
                return 0
            raise
        with lock:
            return args.handler(args)
    except Fail as error:
        print(f"accsw: {error}", file=sys.stderr)
        return 1
    except (OSError, json.JSONDecodeError) as error:
        print(f"accsw: {type(error).__name__}: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\naccsw: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
