#!/usr/bin/env python3
"""accsw — switch Claude Code and Codex between logged-in accounts, no re-login.

Each account is captured once, then switching is a state swap:

  claude  credential lives in the macOS keychain. The service name is
          "Claude Code-credentials", optionally suffixed with the first 8 hex of
          sha256(CLAUDE_CONFIG_DIR) — so a config dir DOES namespace it, but with
          both CLAUDE_CONFIG_DIR and CLAUDE_SECURESTORAGE_CONFIG_DIR unset there
          is exactly one global item. We park each account's blob in its own
          keychain item and copy the wanted one back into the canonical one.
          The plaintext .credentials.json backend exists in the binary but is
          unreachable on macOS: a successful keychain write deletes that file.
  codex   credential is $CODEX_HOME/auth.json, a plain file. We keep one copy
          per account and write the wanted one back.

Sessions, history and project state are deliberately NOT swapped: they are
shared workspace, not identity, and they weigh ~11 GB.
"""

from __future__ import annotations

import argparse
import json
import os
import pwd
import shutil
import datetime
import http.client
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HOME = Path.home()
STORE = Path(os.environ.get("ACCSW_HOME", HOME / ".config" / "accsw"))
REGISTRY = STORE / "registry.json"
CODEX_VAULT = STORE / "codex"

CLAUDE_KEYCHAIN_SERVICE = "Claude Code-credentials"
CLAUDE_KEYCHAIN_ACCOUNT = pwd.getpwuid(os.getuid()).pw_name
CLAUDE_STATE = HOME / ".claude.json"

CODEX_HOME = Path(os.environ.get("CODEX_HOME", HOME / ".codex"))
CODEX_AUTH = CODEX_HOME / "auth.json"

TOOLS = ("claude", "codex")
PROCESS_NAMES = {"claude": ("claude",), "codex": ("codex",)}


class Fail(Exception):
    pass


class RateLimited(Fail):
    """Carries the server's own Retry-After, so we stop asking before it lifts."""

    def __init__(self, message: str, until: int):
        super().__init__(message)
        self.until = until


# ---------------------------------------------------------------- primitives


ITEM_NOT_FOUND = 44


def run(command: list[str], *, stdin: str | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(
        command,
        input=stdin,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )


def atomic_write(path: Path, data: str, mode: int = 0o600) -> None:
    """Write through a sibling temp file: never truncate the target, never widen it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, staged = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        os.fchmod(handle, mode)
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(staged, path)
    except BaseException:
        Path(staged).unlink(missing_ok=True)
        raise


def looks_hex(text: str) -> bool:
    return (
        not text.startswith("{")
        and len(text) % 2 == 0
        and bool(text)
        and all(char in "0123456789abcdef" for char in text)
    )


def diagnose(result: subprocess.CompletedProcess, secret: str | None = None) -> str:
    """`security` echoes its arguments on failure, so its stderr can contain the secret.

    Never interpolate it raw. Anything carrying the payload — or its hex — is dropped.
    """
    text = " ".join(result.stderr.split())
    if secret:
        hexed = secret.encode("utf-8").hex()
        # Wrapped output carries fragments, not the whole payload, so containment
        # alone would pass the very case this exists for: any long run of hex, or
        # any slice of the secret, is enough to refuse.
        fragments = (hexed[i : i + 32] for i in range(0, len(hexed), 32))
        if secret in text or any(piece and piece in text for piece in fragments):
            return "(diagnostic withheld: it contained the credential)"
    return text[:200] or f"exit {result.returncode}"


def keychain_read(service: str) -> str | None:
    """None means the item is genuinely absent; anything else that went wrong raises."""
    result = run(
        ["security", "find-generic-password", "-s", service, "-a", CLAUDE_KEYCHAIN_ACCOUNT, "-w"]
    )
    if result.returncode == ITEM_NOT_FOUND:
        return None
    if result.returncode != 0:
        raise Fail(f"keychain read failed for {service}: {diagnose(result)}")
    secret = result.stdout.strip()
    if not secret:
        return None
    # `security -w` prints hex whenever the stored bytes are not printable ASCII.
    if looks_hex(secret):
        try:
            return bytes.fromhex(secret).decode("utf-8")
        except (ValueError, UnicodeDecodeError):
            raise Fail(f"keychain item {service} is not decodable UTF-8")
    return secret


def keychain_write(service: str, secret: str, label: str) -> None:
    """Written as hex via -X.

    Batch mode (`security -i`) looks safer — the secret would stay off the argument
    list — but it wraps long lines and then reports each fragment as an unknown
    command, printing the credential to the terminal. Real blobs are ~8 KB, so that
    fires every time. Argument passing is the mechanism that actually works; the
    residual exposure is a few milliseconds in this user's own process list.
    """
    result = run(
        [
            "security",
            "add-generic-password",
            "-U",
            "-a",
            CLAUDE_KEYCHAIN_ACCOUNT,
            "-s",
            service,
            "-l",
            label,
            "-X",
            secret.encode("utf-8").hex(),
        ]
    )
    if result.returncode != 0:
        raise Fail(f"keychain write failed for {service}: {diagnose(result, secret)}")
    if keychain_read(service) != secret:
        raise Fail(f"keychain write for {service} did not round-trip; nothing was switched")


def keychain_delete(service: str) -> None:
    """Loop: a service can hold duplicates, and a silent failure would strand a token."""
    while True:
        result = run(
            [
                "security",
                "delete-generic-password",
                "-s",
                service,
                "-a",
                CLAUDE_KEYCHAIN_ACCOUNT,
            ]
        )
        if result.returncode == ITEM_NOT_FOUND:
            return
        if result.returncode != 0:
            raise Fail(f"keychain delete failed for {service}: {diagnose(result)}")


def profile_service(profile: str) -> str:
    return f"accsw-claude-{profile}"


def read_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise Fail(f"{path} is not valid JSON: {error}")
    except OSError as error:
        raise Fail(f"cannot read {path}: {error}")


def load_registry() -> dict:
    if not REGISTRY.is_file():
        return {"profiles": {}, "active": {}}
    return read_json(REGISTRY)


def save_registry(registry: dict) -> None:
    STORE.mkdir(parents=True, exist_ok=True)
    STORE.chmod(0o700)
    atomic_write(REGISTRY, json.dumps(registry, indent=2) + "\n")


def running(tool: str) -> list[int]:
    pids: set[int] = set()
    for name in PROCESS_NAMES[tool]:
        result = run(["pgrep", "-x", name])
        if result.returncode == 0:
            pids.update(int(line) for line in result.stdout.split() if line.isdigit())
    return sorted(pids)


# ------------------------------------------------------------------ identity




def jwt_email(token) -> str | None:
    """Read the email claim without verifying: it is only ever used as a label."""
    if not isinstance(token, str) or token.count(".") != 2:
        return None
    import base64

    body = token.split(".")[1]
    body += "=" * (-len(body) % 4)
    try:
        return json.loads(base64.urlsafe_b64decode(body)).get("email")
    except (ValueError, json.JSONDecodeError):
        return None



def set_claude_oauth_account(account: dict) -> None:
    """Rewrite only the oauthAccount key; the rest of .claude.json is workspace state."""
    if not CLAUDE_STATE.is_file():
        raise Fail(f"{CLAUDE_STATE} does not exist — run Claude Code once before switching")
    state = read_json(CLAUDE_STATE)
    state["oauthAccount"] = account
    atomic_write(CLAUDE_STATE, json.dumps(state, indent=2) + "\n")


# ------------------------------------------------------------------ capture


def slugify(text: str) -> str:
    cleaned = "".join(char if char.isalnum() else "-" for char in text.lower())
    return "-".join(part for part in cleaned.split("-") if part)


def name_for(email: str, tool: str, registry: dict) -> str:
    """The profile an account belongs in: its own, or a free name derived from its address."""
    local, _, domain = email.partition("@")
    candidates = [slugify(local)]
    if domain:
        candidates.append(f"{slugify(local)}-{slugify(domain.split('.')[0])}")
    for name in candidates:
        owner = registry["profiles"].get(name, {}).get(tool, {}).get("email")
        if owner is None or owner == email:
            return name
    base = candidates[-1]
    suffix = 2
    while f"{base}-{suffix}" in registry["profiles"]:
        suffix += 1
    return f"{base}-{suffix}"



def live_blob(tool: str) -> str | None:
    if tool == "claude":
        return keychain_read(CLAUDE_KEYCHAIN_SERVICE)
    return read_file(CODEX_AUTH)


def parked_blob(tool: str, profile: str) -> str | None:
    if tool == "claude":
        return keychain_read(profile_service(profile))
    return read_file(CODEX_VAULT / f"{profile}.json")


def credential_owner(tool: str, blob: str) -> str | None:
    """Who a credential actually belongs to, asked of the credential itself.

    Never inferred from ~/.claude.json: that file and the keychain drift apart
    constantly — a live session refreshes the keychain while the file still names
    the previous account — and trusting it filed one account's token under another
    account's name, silently destroying the credentials it was meant to protect.
    """
    if tool == "codex":
        return jwt_email((json.loads(blob).get("tokens") or {}).get("id_token"))
    return claude_oauth_identity(claude_access_token(blob))["emailAddress"]


def token_expiry(tool: str, blob: str) -> float | None:
    """Seconds left on the sign-in this blob carries, whichever tool it belongs to."""
    return claude_token_expiry(blob) if tool == "claude" else codex_token_expiry(blob)


def fresher(tool: str, candidate: str, other: str) -> bool:
    """Is `candidate` a later sign-in than `other`? Unknown expiry never wins."""
    left = token_expiry(tool, candidate)
    right = token_expiry(tool, other)
    return left is not None and right is not None and left > right


def actually_loaded(tool: str, registry: dict) -> str | None:
    """The profile whose bytes are really in the slot, not the one the registry claims.

    The two drift: a credential can be removed, refreshed, or replaced by something
    outside accsw. Trusting the record meant an empty slot could be reported as
    "already on X" forever, and never repaired.
    """
    live = live_blob(tool)
    if live is None:
        return None
    for name in registry["profiles"]:
        if parked_blob(tool, name) == live:
            return name
    return None


def absorb_live(registry: dict) -> list[str]:
    """Park whatever is signed in right now, under a name derived from the account.

    This runs before every command that touches the slot, which is why `save` is
    optional: a login made outside accsw is picked up on its own, and a parked copy
    can never go stale behind a live session that keeps refreshing its token.
    Writes only when the parked bytes actually differ, so the common case is two
    cheap reads and nothing else.
    """
    if os.environ.get("ACCSW_ABSORB") == "0":
        return []
    absorbed = []
    for tool in TOOLS:
        live = live_blob(tool)
        if live is None:
            continue
        recorded = registry.get("active", {}).get(tool)
        if recorded and parked_blob(tool, recorded) == live:
            continue
        try:
            email = credential_owner(tool, live)
        except (Fail, json.JSONDecodeError):
            continue
        if email is None:
            continue
        name = name_for(email, tool, registry)
        known = registry["profiles"].get(name, {}).get(tool)
        parked = parked_blob(tool, name)
        if known and parked == live:
            registry.setdefault("active", {})[tool] = name
            continue
        if parked is not None and fresher(tool, parked, live):
            # The locker holds a newer sign-in than the slot — a freshly added account
            # whose credential has not been installed yet. Absorbing here would
            # overwrite it with the older one and undo the sign-in.
            RESTORE[tool](name, registry)
            absorbed.append(f"{tool}: installed the newer sign-in for {name}")
            continue
        CAPTURE[tool](name, registry)
        absorbed.append(f"{tool}: {email} → {name}")
    return absorbed





def capture_claude(profile: str, registry: dict) -> str:
    secret = keychain_read(CLAUDE_KEYCHAIN_SERVICE)
    if secret is None:
        raise Fail(
            "no Claude Code credential in the keychain — run `claude` and log in first"
        )
    account = claude_oauth_identity(claude_access_token(secret))
    email = account["emailAddress"]
    keychain_write(profile_service(profile), secret, f"accsw claude — {profile}")
    entry = registry["profiles"].setdefault(profile, {})
    entry["claude"] = {"email": email, "oauthAccount": account}
    registry.setdefault("active", {})["claude"] = profile
    return email or "unknown"


def capture_codex(profile: str, registry: dict) -> str:
    if not CODEX_AUTH.is_file():
        raise Fail(f"no Codex credential at {CODEX_AUTH} — run `codex login` first")
    email = credential_owner("codex", CODEX_AUTH.read_text(encoding="utf-8"))
    CODEX_VAULT.mkdir(parents=True, exist_ok=True)
    CODEX_VAULT.chmod(0o700)
    atomic_write(CODEX_VAULT / f"{profile}.json", CODEX_AUTH.read_text(encoding="utf-8"))
    entry = registry["profiles"].setdefault(profile, {})
    entry["codex"] = {"email": email}
    registry.setdefault("active", {})["codex"] = profile
    return email or "unknown"


# ------------------------------------------------------------------ restore


def preflight_claude(profile: str, registry: dict) -> None:
    """Everything that must be true before a single byte is written."""
    stored = registry["profiles"].get(profile, {}).get("claude")
    if stored is None:
        raise Fail(f"profile {profile!r} has no captured Claude account")
    if not stored.get("oauthAccount"):
        raise Fail(
            f"profile {profile!r} was captured without its identity — "
            f"sign it in again with `accsw add claude`"
        )
    secret = keychain_read(profile_service(profile))
    if secret is None:
        raise Fail(
            f"profile {profile!r} lost its keychain item — `accsw add claude` will restore it"
        )
    json.loads(secret)
    if not CLAUDE_STATE.is_file():
        raise Fail(f"{CLAUDE_STATE} does not exist — run Claude Code once before switching")
    read_json(CLAUDE_STATE)


def preflight_codex(profile: str, registry: dict) -> None:
    stored = registry["profiles"].get(profile, {}).get("codex")
    source = CODEX_VAULT / f"{profile}.json"
    if stored is None or not source.is_file():
        raise Fail(f"profile {profile!r} has no captured Codex account")
    read_json(source)


def restore_claude(profile: str, registry: dict) -> str:
    stored = registry["profiles"][profile]["claude"]
    secret = keychain_read(profile_service(profile))
    left = claude_token_expiry(secret)
    if left is not None and left <= 300:
        renewed = refresh_claude(secret)
        if renewed is None:
            stored["needs_signin"] = True
            save_registry(registry)
            raise Fail(
                f"{profile}'s Claude sign-in was refused — `accsw add claude` will sign it in again"
            )
        # Both copies together: the refresh token that produced this is now spent.
        keychain_write(profile_service(profile), renewed, f"accsw claude — {profile}")
        secret = renewed
        note(f"renewed {profile}'s Claude sign-in")
    keychain_write(CLAUDE_KEYCHAIN_SERVICE, secret, "Claude Code")
    set_claude_oauth_account(stored["oauthAccount"])
    registry.setdefault("active", {})["claude"] = profile
    return stored.get("email") or "unknown"


class Unreachable(Fail):
    """The token endpoint could not be asked — which says nothing about the grant."""


def token_grant(request) -> dict:
    """POST a token request. An empty dict means the grant was refused.

    A refusal and an unreachable endpoint are different facts and must not collapse
    into one: the first retires an account, the second is a bad minute of wifi.
    """
    import urllib.error
    import urllib.request

    try:
        with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as response:
            granted = json.loads(response.read())
    except urllib.error.HTTPError as error:
        if error.code in (400, 401, 403):
            return {}
        raise Unreachable(f"token endpoint returned {error.code}")
    except urllib.error.URLError as error:
        raise Unreachable(f"token endpoint unreachable ({error.reason})")
    except json.JSONDecodeError:
        raise Unreachable("token endpoint returned something that is not JSON")
    except (TimeoutError, OSError, http.client.HTTPException) as error:
        # The POST landed, so the server has already rotated. Losing the reply is
        # not a refusal, and must never be recorded as one.
        raise Unreachable(f"token reply lost ({type(error).__name__}) — rotation may be spent")
    return granted if isinstance(granted, dict) else {}


CLAUDE_TOKEN_URL = "https://platform.claude.com/v1/oauth/token"
CLAUDE_CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"


def claude_token_expiry(blob: str) -> float | None:
    """Seconds left on the access token, from the expiresAt the blob carries in ms."""
    expiry = (json.loads(blob).get("claudeAiOauth") or {}).get("expiresAt")
    return None if not expiry else expiry / 1000 - time.time()


def refresh_claude(blob: str) -> str | None:
    """Trade the refresh token for a fresh set. Returns None if the grant is dead.

    JSON body and a scope list, unlike Codex's form-encoded call — both shapes were
    read out of the clients that own them rather than guessed.
    """
    import urllib.error
    import urllib.request

    payload = json.loads(blob)
    oauth = payload.get("claudeAiOauth") or {}
    if not oauth.get("refreshToken"):
        return None
    if os.environ.get("ACCSW_OFFLINE") == "1":
        raise Fail("offline: refused to call platform.claude.com")
    body = json.dumps(
        {
            "grant_type": "refresh_token",
            "refresh_token": oauth["refreshToken"],
            "client_id": CLAUDE_CLIENT_ID,
            "scope": " ".join(oauth.get("scopes") or []),
        }
    ).encode()
    request = urllib.request.Request(
        CLAUDE_TOKEN_URL, data=body, headers={"Content-Type": "application/json"}
    )
    granted = token_grant(request)
    if not granted.get("access_token"):
        # A 200 carrying {"error": "invalid_grant"} satisfies none of the fields we
        # came for. Returning the untouched blob would report a renewal and install
        # the expired credential it was meant to replace.
        return None
    oauth["accessToken"] = granted["access_token"]
    if granted.get("refresh_token"):
        oauth["refreshToken"] = granted["refresh_token"]
    if granted.get("expires_in"):
        oauth["expiresAt"] = int((time.time() + granted["expires_in"]) * 1000)
    payload["claudeAiOauth"] = oauth
    return json.dumps(payload)


CODEX_TOKEN_URL = "https://auth.openai.com/oauth/token"
CODEX_CLIENT_ID = "app_EMoamEEZ73f0CkXaXp7hrann"


def refresh_codex(blob: str) -> str | None:
    """Trade the refresh token for a fresh set. Returns None if the grant is dead.

    The refresh token rotates, so the result must replace BOTH the parked copy and
    the live slot: keeping an old one around leaves a credential that looks valid
    and is not.
    """
    import urllib.error
    import urllib.parse
    import urllib.request

    payload = json.loads(blob)
    tokens = payload.get("tokens") or {}
    if not tokens.get("refresh_token"):
        return None
    if os.environ.get("ACCSW_OFFLINE") == "1":
        raise Fail("offline: refused to call auth.openai.com")
    body = urllib.parse.urlencode(
        {
            "grant_type": "refresh_token",
            "refresh_token": tokens["refresh_token"],
            "client_id": CODEX_CLIENT_ID,
        }
    ).encode()
    request = urllib.request.Request(
        CODEX_TOKEN_URL,
        data=body,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
    )
    granted = token_grant(request)
    if not granted.get("access_token") or not granted.get("id_token"):
        # id_token included on purpose: it carries the expiry the app checks, so a
        # grant without one cannot be stamped as fresh.
        return None
    for field in ("id_token", "access_token", "refresh_token"):
        if granted.get(field):
            tokens[field] = granted[field]
    payload["tokens"] = tokens
    payload["last_refresh"] = datetime.datetime.now(datetime.UTC).isoformat()
    return json.dumps(payload, indent=2)


def codex_token_expiry(blob: str) -> float | None:
    """Seconds left on the id_token, which lives about an hour — far less than the
    access token's ten days. A parked copy older than that is refused by the app."""
    import base64

    token = (json.loads(blob).get("tokens") or {}).get("id_token")
    if not isinstance(token, str) or token.count(".") != 2:
        return None
    body = token.split(".")[1]
    body += "=" * (-len(body) % 4)
    try:
        expiry = json.loads(base64.urlsafe_b64decode(body)).get("exp")
    except (ValueError, json.JSONDecodeError):
        return None
    return None if not expiry else expiry - time.time()


def restore_codex(profile: str, registry: dict) -> str:
    stored = registry["profiles"][profile]["codex"]
    source = CODEX_VAULT / f"{profile}.json"
    blob = source.read_text(encoding="utf-8")
    left = codex_token_expiry(blob)
    if left is not None and left <= 300:
        renewed = refresh_codex(blob)
        if renewed is None:
            # Remember it: a grant that cannot be renewed will not renew itself, and
            # retrying costs a rotation every time. Cleared by `accsw add`.
            stored["needs_signin"] = True
            save_registry(registry)
            raise Fail(
                f"{profile}'s Codex sign-in is dead — `accsw add codex` will sign it in again"
            )
        else:
            # Both copies, together: the old refresh token is dead the moment this
            # succeeds, so leaving either one behind strands the account.
            atomic_write(source, renewed)
            blob = renewed
            note(f"renewed {profile}'s Codex sign-in")
    atomic_write(CODEX_AUTH, blob)
    registry.setdefault("active", {})["codex"] = profile
    return stored.get("email") or "unknown"


CAPTURE = {"claude": capture_claude, "codex": capture_codex}
RESTORE = {"claude": restore_claude, "codex": restore_codex}
PREFLIGHT = {"claude": preflight_claude, "codex": preflight_codex}


def hold_lock() -> object:
    """One command at a time.

    Every command reads the registry, changes a credential slot and writes back.
    Two runs interleaved lose one of the two, and can leave the slot holding one
    account while the registry names another.
    """
    import fcntl

    STORE.mkdir(parents=True, exist_ok=True)
    handle = open(STORE / ".lock", "w")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        raise Fail("another accsw is running — wait for it to finish")
    return handle


def load_state() -> dict:
    """The registry, with whatever is signed in already parked into it."""
    registry = load_registry()
    if absorb_live(registry):
        save_registry(registry)
    return registry


